---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.tsx';
import Footer from '../../components/layout/Footer.tsx';
import NetworkHero from '../../components/3d/NetworkHero.tsx';
import FeedbackDisplay from '../../components/ui/FeedbackDisplay.tsx';
import el from '../../i18n/el.json';

const locale = 'el';
const t = el;
---

<BaseLayout title={t.site.title} description={t.site.description} lang={locale}>
  <Header locale={locale} translations={t} client:load />

  {/* Hero Section */}
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-16">
    <div class="absolute inset-0">
      <NetworkHero client:load />
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-surface/80 via-surface/50 to-surface/90"></div>
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, var(--color-primary) 1px, transparent 0); background-size: 40px 40px;"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 border border-primary/20 text-primary text-sm font-medium mb-8 animate-fade-in">
        <span class="w-2 h-2 bg-primary rounded-full animate-pulse"></span>
        Προετοιμασία Εξέτασης CCNA 200-301
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-6 animate-fade-in" style="animation-delay: 0.1s;">
        <span class="bg-gradient-to-r from-primary via-accent-light to-accent bg-clip-text text-transparent">
          {t.hero.title}
        </span>
      </h1>

      <p class="text-lg sm:text-xl text-text-muted max-w-3xl mx-auto mb-10 animate-fade-in" style="animation-delay: 0.2s;">
        {t.hero.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16 animate-fade-in" style="animation-delay: 0.3s;">
        <a
          href={`/${locale}/login?mode=signup`}
          class="px-8 py-4 text-lg font-semibold bg-gradient-to-r from-primary to-accent text-white rounded-xl hover:opacity-90 transition-all hover:scale-105 shadow-lg shadow-primary/25"
        >
          {t.hero.cta_primary} →
        </a>
        <a
          href={`/${locale}/curriculum`}
          class="px-8 py-4 text-lg font-semibold border border-primary/30 text-primary rounded-xl hover:bg-primary/10 transition-all"
        >
          {t.hero.cta_secondary}
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 max-w-2xl mx-auto animate-fade-in" style="animation-delay: 0.4s;">
        <div class="text-center">
          <div class="text-3xl font-bold text-primary">35</div>
          <div class="text-sm text-text-muted">Μαθήματα</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary">6</div>
          <div class="text-sm text-text-muted">Ενότητες</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary">80+</div>
          <div class="text-sm text-text-muted">Ερωτήσεις</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-primary">3D</div>
          <div class="text-sm text-text-muted">Διαδραστικό</div>
        </div>
      </div>
    </div>
  </section>

  {/* Curriculum Overview */}
  <section class="py-24 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">{t.modules.title}</h2>
        <p class="text-text-muted max-w-2xl mx-auto">{t.modules.subtitle}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { num: 1, name: t.module_names['1'], desc: t.module_descriptions['1'], lessons: 8, weight: '20%', color: 'from-blue-500 to-cyan-500' },
          { num: 2, name: t.module_names['2'], desc: t.module_descriptions['2'], lessons: 7, weight: '20%', color: 'from-purple-500 to-pink-500' },
          { num: 3, name: t.module_names['3'], desc: t.module_descriptions['3'], lessons: 6, weight: '25%', color: 'from-green-500 to-emerald-500' },
          { num: 4, name: t.module_names['4'], desc: t.module_descriptions['4'], lessons: 5, weight: '10%', color: 'from-orange-500 to-red-500' },
          { num: 5, name: t.module_names['5'], desc: t.module_descriptions['5'], lessons: 5, weight: '15%', color: 'from-red-500 to-rose-500' },
          { num: 6, name: t.module_names['6'], desc: t.module_descriptions['6'], lessons: 4, weight: '10%', color: 'from-indigo-500 to-violet-500' },
        ].map((module) => (
          <a
            href={`/${locale}/lessons/${module.num}/1`}
            class="group relative bg-surface-card rounded-2xl border border-primary/10 hover:border-primary/30 p-6 transition-all hover:scale-[1.02] hover:shadow-lg hover:shadow-primary/10"
          >
            <div class={`inline-flex items-center justify-center w-12 h-12 rounded-xl bg-gradient-to-br ${module.color} text-white font-bold text-lg mb-4`}>
              {module.num}
            </div>
            <div class="absolute top-4 right-4 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-medium">
              {module.weight} εξέταση
            </div>
            <h3 class="text-xl font-bold text-text mb-2 group-hover:text-primary transition-colors">
              {module.name}
            </h3>
            <p class="text-text-muted text-sm mb-4 line-clamp-2">{module.desc}</p>
            <div class="flex items-center justify-between text-sm">
              <span class="text-text-muted">{module.lessons} {t.modules.lessons}</span>
              <span class="text-primary opacity-0 group-hover:opacity-100 transition-opacity">Ξεκινήστε →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Student Feedback Section */}
  <FeedbackDisplay locale={locale} client:load />

  <Footer locale={locale} translations={t} />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.tsx';
import Footer from '../../components/layout/Footer.tsx';
import el from '../../i18n/el.json';

const locale = 'el' as const;
const t = el;
---

<BaseLayout title="Admin Dashboard" lang={locale}>
  <Header locale={locale} translations={t} client:load />

  <div id="access-denied" class="min-h-screen flex items-center justify-center pt-16">
    <div class="text-center max-w-md mx-auto px-4">
      <div class="text-6xl mb-6">🔒</div>
      <h1 class="text-3xl font-bold text-text mb-4">Απόρριψη Πρόσβασης</h1>
      <p class="text-text-muted mb-6">Πρέπει να είστε συνδεδεμένοι με τον λογαριασμό admin για πρόσβαση.</p>
      <a href={`/${locale}/login`} class="inline-flex px-6 py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity">
        Σύνδεση ως Admin →
      </a>
    </div>
  </div>

  <div id="admin-content" class="hidden">
  <main class="pt-24 pb-16 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl font-bold text-text">🔧 Admin Dashboard</h1>
          <p class="text-text-muted">Διαχείριση πλατφόρμας NetworkLearn</p>
        </div>
        <div class="flex items-center gap-3">
          <span class="px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-medium">Admin</span>
          <span class="text-sm text-text-muted" id="admin-email">tsiartasantreas@gmail.com</span>
        </div>
      </div>

      <div class="flex gap-1 mb-8 bg-surface-card rounded-xl p-1 border border-primary/10 overflow-x-auto">
        <button class="tab-btn active px-4 py-2 rounded-lg text-sm font-medium transition-all" data-tab="stats">📊 Στατιστικά</button>
        <button class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all" data-tab="users">👥 Χρήστες</button>
        <button class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all" data-tab="subscriptions">💳 Συνδρομές</button>
        <button class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all" data-tab="revolut">💰 Revolut</button>
        <button class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all" data-tab="supabase">🗄️ Supabase</button>
        <button class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all" data-tab="settings">⚙️ Ρυθμίσεις</button>
      </div>

      {/* Statistics Tab */}
      <div id="tab-stats" class="tab-content">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="text-sm text-text-muted mb-1">Σύνολο Χρηστών</div>
            <div class="text-3xl font-bold text-primary" id="stat-total-users-el">0</div>
          </div>
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="text-sm text-text-muted mb-1">Pro Χρήστες</div>
            <div class="text-3xl font-bold text-accent" id="stat-pro-users-el">0</div>
          </div>
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="text-sm text-text-muted mb-1">Έσοδα (Μήνας)</div>
            <div class="text-3xl font-bold text-warning" id="stat-revenue-el">€0.00</div>
          </div>
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="text-sm text-text-muted mb-1">Νέοι Εβδομάδας</div>
            <div class="text-3xl font-bold text-success" id="stat-new-week-el">0</div>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="text-sm text-text-muted mb-1">Μέσος Όρος Τεστ</div>
            <div class="text-2xl font-bold text-text" id="stat-avg-score-el">0%</div>
          </div>
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="text-sm text-text-muted mb-1">Μαθήματα Ολοκληρώθηκαν</div>
            <div class="text-2xl font-bold text-text" id="stat-lessons-el">0</div>
          </div>
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="text-sm text-text-muted mb-1">Τεστ Εκτελέστηκαν</div>
            <div class="text-2xl font-bold text-text" id="stat-quizzes-el">0</div>
          </div>
        </div>
      </div>

      {/* Users Tab */}
      <div id="tab-users" class="tab-content hidden">
        <div class="bg-surface-card rounded-xl border border-primary/10 overflow-hidden">
          <div class="p-4 border-b border-primary/10">
            <h3 class="text-lg font-bold text-text">Εγγεγραμμένοι Χρήστες</h3>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-primary/10">
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Χρήστης</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">ID</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Πλάνο</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Μαθήματα</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Βαθμολογία</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Πιστοποιητικό</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Ενέργειες</th>
                </tr>
              </thead>
              <tbody id="users-table-body-el">
                <tr><td colspan="6" class="px-4 py-8 text-center text-text-muted">Φόρτωση...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      {/* Subscriptions Tab */}
      <div id="tab-subscriptions" class="tab-content hidden">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-8">
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="text-sm text-text-muted mb-1">Ενεργές Συνδρομές</div>
            <div class="text-3xl font-bold text-success" id="active-subs-count">0</div>
          </div>
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="text-sm text-text-muted mb-1">Μηνιαίο Έσοδο</div>
            <div class="text-3xl font-bold text-primary" id="monthly-revenue">€0.00</div>
          </div>
        </div>

        <div class="bg-surface-card rounded-xl border border-primary/10 overflow-hidden">
          <div class="p-4 border-b border-primary/10 flex items-center justify-between">
            <h3 class="text-lg font-bold text-text">Συνδρομές Pro</h3>
            <button id="refresh-subs-btn" class="px-3 py-1.5 bg-primary/10 text-primary rounded-lg text-sm font-medium hover:bg-primary/20 transition-colors flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
              Ανανέωση
            </button>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-primary/10">
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Χρήστης</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">ID</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Πλάνο</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Κατάσταση</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Ποσό</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Από</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Ενέργειες</th>
                </tr>
              </thead>
              <tbody id="subscriptions-table-body">
                <tr><td colspan="7" class="px-4 py-8 text-center text-text-muted">Φόρτωση...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      {/* Revolut Tab */}
      <div id="tab-revolut" class="tab-content hidden">
        <div class="bg-surface-card rounded-xl border border-primary/10 p-6 mb-6">
          <h3 class="text-lg font-bold text-text mb-4">💰 Revolut Business API Configuration</h3>
          <p class="text-sm text-text-muted mb-4">Τα API keys αποθηκεύονται στον server για ασφάλεια. Διαμορφώστε μέσω Supabase Edge Function environment variables.</p>
          <div class="bg-success/10 rounded-lg p-4">
            <p class="text-sm text-success">✓ Τα Revolut API credentials αποθηκεύονται με ασφάλεια στον server.</p>
          </div>
        </div>

        <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
          <h3 class="text-lg font-bold text-text mb-4">Διαμόρφωση Webhook</h3>
          <p class="text-text-muted text-sm mb-4">Διαμορφώστε αυτό το webhook URL στο Revolut Business dashboard σας:</p>
          <div class="flex items-center gap-2">
            <code class="flex-1 px-4 py-2 bg-surface rounded-lg text-primary text-sm font-mono">https://ccna-platform.wasmer.app/api/revolut/webhook</code>
            <button class="px-3 py-2 bg-primary/10 text-primary rounded-lg text-sm font-medium" onclick="navigator.clipboard.writeText('https://ccna-platform.wasmer.app/api/revolut/webhook')">Αντιγραφή</button>
          </div>
        </div>
      </div>

      {/* Supabase Tab */}
      <div id="tab-supabase" class="tab-content hidden">
        <div class="bg-surface-card rounded-xl border border-primary/10 p-6 mb-6">
          <h3 class="text-lg font-bold text-text mb-4">🗄️ Supabase Configuration</h3>
          <p class="text-sm text-text-muted mb-4">Τα Supabase keys είναι διαμορφωμένα στον server μέσω environment variables για ασφάλεια.</p>
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-text mb-1">Project URL</label>
              <div class="px-4 py-2 bg-surface-light border border-primary/10 rounded-lg text-text font-mono text-sm">https://jhesstimsojwmkdysmpy.supabase.co</div>
            </div>
            <div>
              <label class="block text-sm font-medium text-text mb-1">Anon Key (Public)</label>
              <div class="px-4 py-2 bg-surface-light border border-primary/10 rounded-lg text-text-muted font-mono text-sm">Διαμορφωμένο μέσω environment variable</div>
            </div>
            <div class="bg-success/10 rounded-lg p-4">
              <p class="text-sm text-success">✓ Όλα τα ευαίσθητα keys αποθηκεύονται στον server και δεν εκτίθενται στον browser.</p>
            </div>
          </div>
        </div>

        <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
          <h3 class="text-lg font-bold text-text mb-4">Κατάσταση Βάσης Δεδομένων</h3>
          <div class="grid grid-cols-2 gap-4">
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 rounded-full bg-success"></div>
              <span class="text-sm text-text">profiles table</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 rounded-full bg-success"></div>
              <span class="text-sm text-text">lesson_progress table</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 rounded-full bg-success"></div>
              <span class="text-sm text-text">quiz_scores table</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 rounded-full bg-success"></div>
              <span class="text-sm text-text">user_points table</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 rounded-full bg-success"></div>
              <span class="text-sm text-text">RLS policies</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 rounded-full bg-success"></div>
              <span class="text-sm text-text">Triggers</span>
            </div>
          </div>
        </div>
      </div>

      {/* Settings Tab */}
      <div id="tab-settings" class="tab-content hidden">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {/* General Settings */}
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <h3 class="text-lg font-bold text-text mb-4">⚙️ Γενικές Ρυθμίσεις</h3>
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-text mb-1">Όνομα Ιστοσελίδας</label>
                <input type="text" id="site-name" value="NetworkLearn" class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text" />
                <p class="text-xs text-text-muted mt-1">Εμφανίζεται στην κεφαλίδα και τους τίτλους σελίδων</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-text mb-1">Logo URL</label>
                <input type="text" id="logo-url" placeholder="https://example.com/logo.png" class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text" />
                <p class="text-xs text-text-muted mt-1">Εισάγετε URL για την εικόνα logo (PNG/SVG)</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-text mb-1">Προεπισκόπηση Logo</label>
                <div class="flex items-center gap-3 p-3 bg-surface rounded-lg border border-primary/10">
                  <div id="logo-preview" class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-accent flex items-center justify-center text-white font-bold text-xl">N</div>
                  <span id="logo-name-preview" class="text-text font-medium">NetworkLearn</span>
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium text-text mb-1">URL Ιστοσελίδας</label>
                <input type="text" id="site-url" value="https://networklearn.wasmer.app" class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text" />
              </div>
              <button id="save-general" class="w-full px-6 py-2 bg-gradient-to-r from-primary to-accent text-white rounded-lg font-medium hover:opacity-90 transition-opacity">Αποθήκευση Γενικών Ρυθμίσεων</button>
            </div>
          </div>

          {/* Feature Flags */}
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <h3 class="text-lg font-bold text-text mb-4">🚩 Feature Flags</h3>
            <div class="space-y-4">
              <label class="flex items-center justify-between">
                <span class="text-sm text-text">Ενεργοποίηση Εγγραφών</span>
                <input type="checkbox" checked class="w-5 h-5 rounded" id="flag-registration" />
              </label>
              <label class="flex items-center justify-between">
                <span class="text-sm text-text">Ενεργοποίηση Επαναφοράς Κωδικού</span>
                <input type="checkbox" checked class="w-5 h-5 rounded" id="flag-password-reset" />
              </label>
              <label class="flex items-center justify-between">
                <span class="text-sm text-text">Ενεργοποίηση Google OAuth</span>
                <input type="checkbox" class="w-5 h-5 rounded" id="flag-google-oauth" />
              </label>
              <label class="flex items-center justify-between">
                <span class="text-sm text-text">Λειτουργία Συντήρησης</span>
                <input type="checkbox" class="w-5 h-5 rounded" id="flag-maintenance" />
              </label>
            </div>
          </div>

          {/* Email Settings */}
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <h3 class="text-lg font-bold text-text mb-4">📧 Ρυθμίσεις Email (SMTP)</h3>
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-text mb-1">SMTP Host</label>
                <input type="text" id="smtp-host" placeholder="smtp.gmail.com" class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text text-sm" />
              </div>
              <div>
                <label class="block text-sm font-medium text-text mb-1">SMTP Port</label>
                <input type="text" id="smtp-port" value="587" class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text text-sm" />
              </div>
              <div>
                <label class="block text-sm font-medium text-text mb-1">SMTP Username</label>
                <input type="text" id="smtp-user" placeholder="your@email.com" class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text text-sm" />
              </div>
              <div>
                <label class="block text-sm font-medium text-text mb-1">SMTP Password</label>
                <input type="password" id="smtp-pass" class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text text-sm" />
              </div>
              <button id="save-email" class="px-6 py-2 bg-primary/10 text-primary rounded-lg font-medium">Αποθήκευση Ρυθμίσεων Email</button>
            </div>
          </div>

          {/* Payment Settings */}
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <h3 class="text-lg font-bold text-text mb-4">💳 Ρυθμίσεις Πληρωμών (Stripe Backup)</h3>
            <p class="text-sm text-text-muted mb-4">Τα Stripe credentials αποθηκεύονται στον server για ασφάλεια.</p>
            <div class="bg-success/10 rounded-lg p-4">
              <p class="text-sm text-success">✓ Τα credentials πληρωμών αποθηκεύονται με ασφάλεια στον server.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer locale={locale} translations={t} />
  </div>

  <script>
    import { supabase } from '../../lib/supabase';

    function sanitize(str: string | null | undefined): string {
      if (!str) return '';
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    const { data: { session } } = await supabase.auth.getSession();
    const accessDenied = document.getElementById('access-denied');
    const adminContent = document.getElementById('admin-content');

    let isAdmin = false;
    if (session?.user) {
      const { data: adminCheck } = await supabase.rpc('check_is_admin');
      isAdmin = adminCheck === true;
    }

    if (!session?.user || !isAdmin) {
      if (accessDenied) accessDenied.classList.remove('hidden');
      if (adminContent) adminContent.classList.add('hidden');
    } else {
      if (accessDenied) accessDenied.classList.add('hidden');
      if (adminContent) adminContent.classList.remove('hidden');

      async function loadAdminData() {
        const { data: adminData, error: adminError } = await supabase.rpc('admin_get_all_data');
        if (adminError) { console.error('Admin error:', adminError); return; }

        const profiles = adminData?.profiles || [];
        const allProgress = adminData?.lesson_progress || [];
        const allScores = adminData?.quiz_scores || [];
        const adminEmails = adminData?.admin_emails || [];
        const certificates = adminData?.certificates || [];

        const emailMap: Record<string, string> = {};
        adminEmails.forEach((e: any) => { emailMap[e.user_id] = e.email_encrypted; });

        const certMap: Record<string, any> = {};
        certificates.forEach((c: any) => { if (c.is_valid) certMap[c.user_id] = c; });

        const totalUsers = profiles.length;
        const proUsers = profiles.filter((p: any) => p.plan === 'pro').length;
        const revenue = proUsers * 0.99;
        const now = new Date();
        const weekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
        const newThisWeek = profiles.filter((p: any) => new Date(p.created_at) >= weekAgo).length;
        const totalLessons = allProgress.filter((p: any) => p.status === 'completed').length;
        const totalQuizzes = allScores.length;
        const avgScore = allScores.length ? Math.round(allScores.reduce((s: number, q: any) => s + Number(q.score), 0) / allScores.length) : 0;

        document.getElementById('stat-total-users-el')!.textContent = String(totalUsers);
        document.getElementById('stat-pro-users-el')!.textContent = String(proUsers);
        document.getElementById('stat-revenue-el')!.textContent = `€${revenue.toFixed(2)}`;
        document.getElementById('stat-new-week-el')!.textContent = String(newThisWeek);
        document.getElementById('stat-avg-score-el')!.textContent = `${avgScore}%`;
        document.getElementById('stat-lessons-el')!.textContent = totalLessons.toLocaleString();
        document.getElementById('stat-quizzes-el')!.textContent = totalQuizzes.toLocaleString();

        const tableBody = document.getElementById('users-table-body-el');
        if (tableBody) {
          tableBody.innerHTML = profiles.map((p: any) => {
            const up = allProgress.filter((lp: any) => lp.user_id === p.id) || [];
            const us = allScores.filter((qs: any) => qs.user_id === p.id) || [];
            const lc = up.filter((lp: any) => lp.status === 'completed').length;
            const as2 = us.length ? Math.round(us.reduce((s: number, q: any) => s + Number(q.score), 0) / us.length) : 0;
            const em = emailMap[p.id] || p.id.substring(0, 8) + '...';
            const userCert = certMap[p.id];
            const verifyLink = userCert ? `/el/verify/${userCert.verification_code}` : null;

            return `<tr class="border-b border-primary/5 hover:bg-surface-light">
              <td class="px-4 py-3 text-sm text-text font-medium">${sanitize(p.display_name) || 'User'}</td>
              <td class="px-4 py-3 text-sm text-text-muted font-mono text-xs">${sanitize(em)}</td>
              <td class="px-4 py-3"><select class="plan-select-el px-2 py-1 bg-surface border border-primary/10 rounded text-xs text-text" data-user-id="${p.id}"><option value="free" ${p.plan === 'free' ? 'selected' : ''}>Free</option><option value="pro" ${p.plan === 'pro' ? 'selected' : ''}>Pro</option></select></td>
              <td class="px-4 py-3 text-sm text-text">${lc}/35</td>
              <td class="px-4 py-3 text-sm ${as2 >= 80 ? 'text-success' : as2 > 0 ? 'text-warning' : 'text-text-muted'}">${as2 > 0 ? as2 + '%' : '—'}</td>
              <td class="px-4 py-3">${verifyLink ? `<a href="${verifyLink}" target="_blank" class="text-xs text-primary hover:underline">🔗 Προβολή</a>` : `<span class="text-xs text-text-muted">—</span>`}</td>
              <td class="px-4 py-3 flex gap-2 flex-wrap">
                <button class="save-plan-btn-el text-xs text-success hover:underline" data-user-id="${p.id}">Αποθήκευση</button>
                <button class="cert-btn-el text-xs text-accent hover:underline" data-user-id="${p.id}" data-user-name="${sanitize(p.display_name) || 'User'}" data-lessons="${lc}" data-score="${as2}">🎓 Πιστοπ.</button>
                <button class="delete-user-btn-el text-xs text-error hover:underline" data-user-id="${p.id}" data-user-name="${sanitize(p.display_name) || 'User'}">🗑️ Διαγρ.</button>
              </td>
            </tr>`;
          }).join('');

          document.querySelectorAll('.save-plan-btn-el').forEach(btn => {
            btn.addEventListener('click', async () => {
              const userId = btn.getAttribute('data-user-id');
              const select = document.querySelector(`.plan-select-el[data-user-id="${userId}"]`) as HTMLSelectElement;
              if (userId && select) {
                const { error } = await supabase.rpc('admin_update_user_plan', { target_user_id: userId, new_plan: select.value });
                if (error) alert('Σφάλμα: ' + error.message);
                else { alert('Το πλάνο ενημερώθηκε!'); loadAdminData(); }
              }
            });
          });

          document.querySelectorAll('.delete-user-btn-el').forEach(btn => {
            btn.addEventListener('click', async () => {
              const userId = btn.getAttribute('data-user-id');
              const userName = btn.getAttribute('data-user-name') || 'User';
              if (!userId) return;
              if (!confirm(`ΔΙΑΓΡΑΦΗ: ${userName}\n\nΑυτό θα διαγράψει μόνιμα όλα τα δεδομένα. Σίγουρος;`)) return;
              const { error } = await supabase.rpc('delete_user_account', { target_user_id: userId });
              if (error) alert('Σφάλμα: ' + error.message);
              else { alert(`Ο χρήστης ${userName} διαγράφηκε.`); loadAdminData(); }
            });
          });

          document.querySelectorAll('.cert-btn-el').forEach(btn => {
            btn.addEventListener('click', async () => {
              const userName = btn.getAttribute('data-user-name') || 'User';
              if (!confirm(`Δημιουργία πιστοποιητικού για ${userName};`)) return;
              const { jsPDF } = await import('jspdf');
              const doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
              const w = doc.internal.pageSize.getWidth();
              const h = doc.internal.pageSize.getHeight();
              try {
                const templateUrl = 'https://raw.githubusercontent.com/tsiartasantreas/ccna-platform/main/public/images/certificate-bg.png';
                const response = await fetch(templateUrl);
                const blob = await response.blob();
                const reader = new FileReader();
                await new Promise((resolve) => { reader.onload = function() { doc.addImage(reader.result, 'PNG', 0, 0, w, h); resolve(); }; reader.readAsDataURL(blob); });
              } catch(e) { doc.setFillColor(255, 255, 255); doc.rect(0, 0, w, h, 'F'); }
              doc.setTextColor(100, 116, 139); doc.setFontSize(12);
              doc.text('Αυτό το πιστοποιητικό απονέμεται στον/στην', w / 2, 85, { align: 'center' });
              doc.setTextColor(30, 41, 59); doc.setFontSize(40);
              doc.text(userName, w / 2, 105, { align: 'center' });
              doc.setTextColor(100, 116, 139); doc.setFontSize(12);
              doc.text('για την επιτυχή ολοκλήρωση του', w / 2, 125, { align: 'center' });
              doc.setTextColor(30, 41, 59); doc.setFontSize(20);
              doc.text('Προγράμματος Εκπαίδευσης Δικτυακής Μηχανικής', w / 2, 140, { align: 'center' });
              doc.setTextColor(100, 116, 139); doc.setFontSize(11);
              doc.text(`Εκδόθηκε στις ${new Date().toLocaleDateString('el-GR')}`, w / 2, 160, { align: 'center' });
              doc.setTextColor(148, 163, 184); doc.setFontSize(9);
              doc.text('networklearn.wasmer.app', w / 2, h - 18, { align: 'center' });
              doc.save(`NetworkLearn-Certificate-${userName.replace(/\s+/g, '-').toLowerCase()}.pdf`);
              alert(`Το πιστοποιητικό λήφθηκε για ${userName}!`);
            });
          });
        }

        // Update subscriptions table
        const subsBody = document.getElementById('subscriptions-table-body');
        if (subsBody) {
          const proProfiles = profiles.filter((p: any) => p.plan === 'pro');
          const monthlyUsers = proProfiles.length;
          const revenue = monthlyUsers * 0.99;

          document.getElementById('active-subs-count')!.textContent = String(monthlyUsers);
          document.getElementById('monthly-revenue')!.textContent = `€${revenue.toFixed(2)}`;

          subsBody.innerHTML = proProfiles.length > 0 ? proProfiles.map((p: any) => `
            <tr class="border-b border-primary/5 hover:bg-surface-light">
              <td class="px-4 py-3 text-sm text-text">${sanitize(p.display_name) || 'User'}</td>
              <td class="px-4 py-3 text-sm text-text-muted">${p.id.substring(0, 8)}...</td>
              <td class="px-4 py-3 text-sm text-text">Pro</td>
              <td class="px-4 py-3"><span class="px-2 py-0.5 rounded-full bg-success/10 text-success text-xs font-medium">Ενεργό</span></td>
              <td class="px-4 py-3 text-sm text-text">€0.99</td>
              <td class="px-4 py-3 text-sm text-text-muted">${new Date(p.updated_at).toLocaleDateString()}</td>
              <td class="px-4 py-3">
                <button class="cancel-sub-btn-el text-xs text-error hover:underline" data-user-id="${p.id}">Ακύρωση</button>
              </td>
            </tr>
          `).join('') : '<tr><td colspan="7" class="px-4 py-8 text-center text-text-muted">Δεν υπάρχουν ενεργές συνδρομές</td></tr>';

          // Cancel subscription handlers
          document.querySelectorAll('.cancel-sub-btn-el').forEach(btn => {
            btn.addEventListener('click', async () => {
              const userId = btn.getAttribute('data-user-id');
              if (userId && confirm('Ακύρωση συνδρομής; Ο χρήστης θα υποβιβαστεί σε Free.')) {
                const { error } = await supabase.rpc('admin_update_user_plan', {
                  target_user_id: userId,
                  new_plan: 'free'
                });
                if (error) alert('Σφάλμα: ' + error.message);
                else { alert('Η συνδρομή ακυρώθηκε.'); loadAdminData(); }
              }
            });
          });
        }
      }
      loadAdminData();
      setInterval(() => loadAdminData(), 5 * 60 * 1000);
    }

    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab');
        document.querySelectorAll('.tab-btn').forEach(b => {
          b.classList.remove('active', 'bg-primary', 'text-white');
          b.classList.add('text-text-muted');
        });
        btn.classList.add('active', 'bg-primary', 'text-white');
        btn.classList.remove('text-text-muted');
        document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
        const content = document.getElementById(`tab-${tab}`);
        if (content) content.classList.remove('hidden');
      });
    });

    const firstTab = document.querySelector('.tab-btn');
    if (firstTab) {
      firstTab.classList.add('active', 'bg-primary', 'text-white');
      firstTab.classList.remove('text-text-muted');
    }

    document.getElementById('save-revolut')?.addEventListener('click', () => {
      alert('Οι ρυθμίσεις Revolut αποθηκεύτηκαν!');
    });
  </script>
</BaseLayout>

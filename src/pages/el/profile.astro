---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.tsx';
import Footer from '../../components/layout/Footer.tsx';
import el from '../../i18n/el.json';

const locale = 'el' as const;
const t = el;
---

<BaseLayout title={t.profile.title} lang={locale}>
  <Header locale={locale} translations={t} client:load />

  <main class="pt-24 pb-16 min-h-screen">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold mb-8">{t.profile.title}</h1>

      <div class="bg-surface-card rounded-2xl border border-primary/10 p-8 mb-8">
        <h2 class="text-xl font-bold mb-6">Πληροφορίες Λογαριασμού</h2>
        <form id="profile-form" class="space-y-6">
          <div>
            <label for="display-name" class="block text-sm font-medium text-text mb-2">{t.profile.display_name}</label>
            <input type="text" id="display-name" name="display-name" class="w-full px-4 py-3 bg-surface border border-primary/10 rounded-xl text-text placeholder-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Το όνομά σας" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-text mb-2">{t.auth.email}</label>
            <input type="email" id="email" name="email" disabled class="w-full px-4 py-3 bg-surface-light border border-primary/10 rounded-xl text-text-muted cursor-not-allowed" />
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-2">{t.profile.language}</label>
            <div class="flex gap-3">
              <button type="button" class="lang-btn flex-1 px-4 py-3 rounded-xl border border-primary/10 text-text-muted hover:border-primary/30 transition-all" data-lang="en">🇬🇧 English</button>
              <button type="button" class="lang-btn flex-1 px-4 py-3 rounded-xl border-2 border-primary bg-primary/10 text-primary font-medium transition-all" data-lang="el">🇬🇷 Ελληνικά</button>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-text mb-2">{t.profile.theme}</label>
            <div class="flex gap-3">
              <button type="button" class="theme-btn flex-1 px-4 py-3 rounded-xl border-2 border-primary bg-primary/10 text-primary font-medium transition-all" data-theme="dark">🌙 {t.profile.dark}</button>
              <button type="button" class="theme-btn flex-1 px-4 py-3 rounded-xl border border-primary/10 text-text-muted hover:border-primary/30 transition-all" data-theme="light">☀️ {t.profile.light}</button>
            </div>
          </div>
          <button type="submit" class="w-full py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity">{t.profile.save}</button>
        </form>
      </div>

      <div class="bg-surface-card rounded-2xl border border-primary/10 p-8 mb-8">
        <h2 class="text-xl font-bold mb-4">{t.profile.plan}</h2>
        <div class="flex items-center justify-between p-4 bg-surface-light rounded-xl">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary to-accent flex items-center justify-center text-white font-bold text-lg" id="plan-icon">F</div>
            <div>
              <div class="font-bold text-text" id="plan-name">{t.pricing.free} Plan</div>
              <div class="text-sm text-text-muted" id="plan-desc">Βασική πρόσβαση στα μαθήματα</div>
            </div>
          </div>
          <a href={`/${locale}/pricing`} class="px-4 py-2 bg-primary/10 text-primary rounded-lg text-sm font-medium hover:bg-primary/20 transition-colors" id="plan-action">{t.pricing.upgrade}</a>
        </div>
      </div>

      {/* Security */}
      <div class="bg-surface-card rounded-2xl border border-primary/10 p-8 mb-8">
        <h2 class="text-xl font-bold mb-4">🔐 Ασφάλεια</h2>
        <div class="flex items-center justify-between p-4 bg-surface-light rounded-xl">
          <div>
            <div class="font-medium text-text">Κωδικός</div>
            <div class="text-sm text-text-muted">Επαναφορά κωδικού μέσω email</div>
          </div>
          <button id="reset-password-btn" class="px-4 py-2 bg-primary/10 text-primary rounded-lg text-sm font-medium hover:bg-primary/20 transition-colors">
            Επαναφορά Κωδικού
          </button>
        </div>
      </div>

      <div class="bg-surface-card rounded-2xl border border-primary/10 p-8 mb-8">
        <h2 class="text-xl font-bold mb-2">Δεδομένα & Απόρρητο</h2>
        <p class="text-text-muted text-sm mb-6">{t.profile.gdpr_notice}</p>
        <div class="space-y-4">
          <button id="download-data-btn" class="w-full flex items-center justify-between p-4 bg-surface-light rounded-xl hover:bg-surface transition-colors">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-xl">📥</div>
              <div class="text-left">
                <div class="font-medium text-text">{t.profile.download_data}</div>
                <div class="text-xs text-text-muted">Εξαγωγή δεδομένων ως JSON</div>
              </div>
            </div>
          </button>
          <button id="delete-account-btn" class="w-full flex items-center justify-between p-4 bg-error/5 rounded-xl border border-error/20 hover:bg-error/10 transition-colors">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-error/10 flex items-center justify-center text-xl">🗑️</div>
              <div class="text-left">
                <div class="font-medium text-error">{t.profile.delete_account}</div>
                <div class="text-xs text-text-muted">Μόνιμη διαγραφή λογαριασμού</div>
              </div>
            </div>
          </button>
        </div>
      </div>

      <div class="flex flex-wrap gap-4 text-sm text-text-muted">
        <a href={`/${locale}/privacy`} class="hover:text-primary">{t.gdpr.privacy_policy}</a>
        <span>•</span>
        <a href={`/${locale}/terms`} class="hover:text-primary">{t.gdpr.terms_of_service}</a>
      </div>
    </div>
  </main>

  <Footer locale={locale} translations={t} />

  <script>
    import { createClient } from '@supabase/supabase-js';
    const supabase = createClient('https://jhesstimsojwmkdysmpy.supabase.co', 'sb_publishable_bKD9biIulcfC5iNipD-8IA_3Zu4bmWD');

    async function loadProfile() {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) { window.location.href = '/el/login'; return; }

      const { data: profile } = await supabase.from('profiles').select('*').eq('id', session.user.id).single();

      const nameInput = document.getElementById('display-name') as HTMLInputElement;
      const emailInput = document.getElementById('email') as HTMLInputElement;
      if (nameInput) nameInput.value = profile?.display_name || session.user.user_metadata?.display_name || '';
      if (emailInput) emailInput.value = session.user.email || '';

      if (profile?.plan === 'pro') {
        const planIcon = document.getElementById('plan-icon');
        const planName = document.getElementById('plan-name');
        const planDesc = document.getElementById('plan-desc');
        const planAction = document.getElementById('plan-action');
        if (planIcon) { planIcon.textContent = 'P'; planIcon.className = 'w-12 h-12 rounded-xl bg-gradient-to-br from-accent to-primary flex items-center justify-center text-white font-bold text-lg'; }
        if (planName) planName.textContent = 'Pro Plan';
        if (planDesc) planDesc.textContent = 'Πλήρης πρόσβαση σε τεστ, πιστοποιητικό και άλλα';
        if (planAction) { planAction.textContent = 'Ενεργό ✓'; planAction.className = 'px-4 py-2 bg-success/10 text-success rounded-lg text-sm font-medium cursor-default'; planAction.removeAttribute('href'); }
      }
    }
    loadProfile();

    // Password reset
    document.getElementById('reset-password-btn')?.addEventListener('click', async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user?.email) return;
      if (confirm(`Αποστολή email επαναφοράς κωδικού στο ${session.user.email};`)) {
        const { error } = await supabase.auth.resetPasswordForEmail(session.user.email, {
          redirectTo: window.location.origin + '/el/reset-password',
        });
        alert(error ? 'Σφάλμα: ' + error.message : 'Email επαναφοράς κωδικού στάλθηκε!');
      }
    });

    document.querySelectorAll('.theme-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const theme = btn.getAttribute('data-theme') || 'dark';
        document.documentElement.classList.toggle('dark', theme === 'dark');
        document.documentElement.classList.toggle('light', theme === 'light');
        localStorage.setItem('theme', theme);
      });
    });
    document.querySelectorAll('.lang-btn').forEach(btn => {
      btn.addEventListener('click', () => { window.location.href = `/${btn.getAttribute('data-lang') || 'el'}/profile`; });
    });
    document.getElementById('download-data-btn')?.addEventListener('click', async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) return;
      const { data: profile } = await supabase.from('profiles').select('*').eq('id', session.user.id).single();
      const { data: progress } = await supabase.from('lesson_progress').select('*').eq('user_id', session.user.id);
      const { data: scores } = await supabase.from('quiz_scores').select('*').eq('user_id', session.user.id);
      const blob = new Blob([JSON.stringify({ exportDate: new Date().toISOString(), profile, progress, scores }, null, 2)], { type: 'application/json' });
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = `networklearn-data-${new Date().toISOString().split('T')[0]}.json`; a.click();
    });
    document.getElementById('delete-account-btn')?.addEventListener('click', async () => {
      if (confirm('Είστε σίγουροι; Όλα τα δεδομένα θα διαγραφούν μόνιμα.')) {
        const { data: { session } } = await supabase.auth.getSession();
        if (session?.user) { await supabase.from('profiles').update({ display_name: '[DELETED]' }).eq('id', session.user.id); await supabase.auth.signOut(); window.location.href = '/el/'; }
      }
    });
    document.getElementById('profile-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) return;
      const displayName = (document.getElementById('display-name') as HTMLInputElement)?.value;
      const { error } = await supabase.from('profiles').update({ display_name: displayName }).eq('id', session.user.id);
      alert(error ? 'Σφάλμα: ' + error.message : 'Το προφίλ αποθηκεύτηκε!');
    });
  </script>
</BaseLayout>

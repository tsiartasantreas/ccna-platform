---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.tsx';
import Footer from '../../components/layout/Footer.tsx';
import el from '../../i18n/el.json';

const locale = 'el' as const;
const t = el;

const modules = [
  { num: 1, name: 'Θεμέλια Δικτύων', lessons: 8, weight: '20%', color: 'from-blue-500 to-cyan-500', icon: '🌐' },
  { num: 2, name: 'Πρόσβαση Δικτύου', lessons: 7, weight: '20%', color: 'from-purple-500 to-pink-500', icon: '🔌' },
  { num: 3, name: 'Συνδεσιμότητα IP', lessons: 6, weight: '25%', color: 'from-green-500 to-emerald-500', icon: '🛤️' },
  { num: 4, name: 'Υπηρεσίες IP', lessons: 5, weight: '10%', color: 'from-orange-500 to-red-500', icon: '⚙️' },
  { num: 5, name: 'Θεμέλια Ασφάλειας', lessons: 5, weight: '15%', color: 'from-red-500 to-rose-500', icon: '🔒' },
  { num: 6, name: 'Αυτοματοποίηση & Προγραμματισμός', lessons: 4, weight: '10%', color: 'from-indigo-500 to-violet-500', icon: '🤖' },
];
---

<BaseLayout title={t.dashboard.welcome} lang={locale}>
  <Header locale={locale} translations={t} client:load />

  <main class="pt-24 pb-16 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-bold mb-2">{t.dashboard.welcome} 👋</h1>
        <p class="text-text-muted">{t.dashboard.your_progress}</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-xl">🎯</div>
            <span class="text-sm text-text-muted">{t.dashboard.total_points}</span>
          </div>
          <div class="text-3xl font-bold text-primary" id="total-points">0</div>
        </div>
        <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-xl">🔥</div>
            <span class="text-sm text-text-muted">{t.dashboard.current_streak}</span>
          </div>
          <div class="text-3xl font-bold text-accent" id="current-streak">0</div>
        </div>
        <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg bg-success/10 flex items-center justify-center text-xl">📚</div>
            <span class="text-sm text-text-muted">{t.dashboard.modules_completed}</span>
          </div>
          <div class="text-3xl font-bold text-success" id="modules-completed">0/6</div>
        </div>
        <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg bg-warning/10 flex items-center justify-center text-xl">📝</div>
            <span class="text-sm text-text-muted">{t.dashboard.lessons_completed}</span>
          </div>
          <div class="text-3xl font-bold text-warning" id="lessons-completed">0/35</div>
        </div>
      </div>

      <div class="mb-8">
        <h2 class="text-2xl font-bold mb-6">{t.dashboard.your_progress}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {modules.map((module) => (
            <div class="bg-surface-card rounded-xl border border-primary/10 p-6 hover:border-primary/20 transition-colors">
              <div class="flex items-center gap-3 mb-4">
                <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${module.color} flex items-center justify-center text-xl`}>{module.icon}</div>
                <div>
                  <h3 class="font-bold text-text">{module.name}</h3>
                  <p class="text-xs text-text-muted">{module.lessons} μαθήματα • {module.weight} εξέταση</p>
                </div>
              </div>
              <div class="mb-3">
                <div class="flex items-center justify-between text-sm mb-1">
                  <span class="text-text-muted">Πρόοδος</span>
                  <span class="text-primary font-medium" data-module-progress={module.num}>0%</span>
                </div>
                <div class="w-full h-2 bg-surface rounded-full overflow-hidden">
                  <div class="h-full bg-gradient-to-r from-primary to-accent rounded-full transition-all duration-500" style="width: 0%" data-module-bar={module.num} />
                </div>
              </div>
              <a href={`/${locale}/lessons/${module.num}/1`} class="block text-center text-sm text-primary hover:underline">{t.dashboard.continue_learning} →</a>
            </div>
          ))}
        </div>
      </div>

      {/* Quiz & Certificate Section */}
      <div class="mb-8">
        <h2 class="text-2xl font-bold mb-6">🎯 Τεστ & Πιστοποίηση</h2>
        <div class="bg-surface-card rounded-2xl border border-primary/10 p-6 mb-6">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h3 class="text-lg font-bold text-text">Τεστ Ενοτήτων</h3>
              <p class="text-sm text-text-muted">Ολοκληρώστε όλα τα τεστ με 80%+ για πιστοποιητικό</p>
            </div>
            <div id="quiz-progress-badge" class="px-4 py-2 rounded-full bg-surface-light text-text-muted text-sm font-medium">0/6 ολοκληρώθηκαν</div>
          </div>
          <div id="quiz-list" class="space-y-3 mb-6">
            {[
              { num: 1, name: 'Θεμέλια Δικτύων' },
              { num: 2, name: 'Πρόσβαση Δικτύου' },
              { num: 3, name: 'Συνδεσιμότητα IP' },
              { num: 4, name: 'Υπηρεσίες IP' },
              { num: 5, name: 'Θεμέλια Ασφάλειας' },
              { num: 6, name: 'Αυτοματοποίηση' },
            ].map((mod) => (
              <div class="flex items-center justify-between p-3 bg-surface-light rounded-lg" data-quiz-row={mod.num}>
                <div class="flex items-center gap-3">
                  <span class="w-8 h-8 rounded-lg bg-surface flex items-center justify-center text-sm font-bold text-text-muted" data-quiz-badge={mod.num}>{mod.num}</span>
                  <div>
                    <div class="font-medium text-text text-sm">Ενότητα {mod.num}: {mod.name}</div>
                    <div class="text-xs text-text-muted" data-quiz-score={mod.num}>Δεν δοκιμάστηκε</div>
                  </div>
                </div>
                <a href={`/${locale}/lessons/${mod.num}/quiz`} class="text-xs text-primary hover:underline">Τεστ →</a>
              </div>
            ))}
          </div>
          <button id="certificate-btn" class="w-full py-4 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity flex items-center justify-center gap-2">
            🎓 Δημιουργία Πιστοποιητικού
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href={`/${locale}/curriculum`} class="bg-gradient-to-r from-primary/10 to-accent/10 rounded-xl border border-primary/20 p-6 hover:border-primary/40 transition-colors">
          <div class="text-2xl mb-2">📖</div>
          <h3 class="font-bold text-text mb-1">Πρόγραμμα Σπουδών</h3>
          <p class="text-sm text-text-muted">Δείτε και τα 35 μαθήματα σε 6 ενότητες</p>
        </a>
        <button id="upgrade-btn" class="bg-gradient-to-r from-accent/10 to-primary/10 rounded-xl border border-accent/20 p-6 hover:border-accent/40 transition-colors text-left cursor-pointer">
          <div class="text-2xl mb-2">⭐</div>
          <h3 class="font-bold text-text mb-1">Αναβάθμιση σε Pro</h3>
          <p class="text-sm text-text-muted">Ξεκλειδώστε τεστ και πιστοποιητικό</p>
        </button>
      </div>
    </div>
  </main>

  {/* Already Pro Modal */}
  <div id="already-pro-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm">
    <div class="bg-surface-card rounded-2xl border border-primary/10 p-8 max-w-md mx-4 text-center animate-fade-in">
      <div class="text-6xl mb-4">⭐</div>
      <h2 class="text-2xl font-bold text-text mb-2">Είστε ήδη Pro!</h2>
      <p class="text-text-muted mb-6">Έχετε πλήρη πρόσβαση σε όλα τα τεστ, πιστοποιητικά και premium λειτουργίες.</p>
      <button onclick="document.getElementById('already-pro-modal').classList.add('hidden')" class="px-6 py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity">
        Το κατάλαβα!
      </button>
    </div>
  </div>

  {/* Modals */}
  <div id="cert-upgrade-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm">
    <div class="bg-surface-card rounded-2xl border border-primary/10 p-8 max-w-md mx-4 text-center animate-fade-in">
      <div class="text-6xl mb-4">🔒</div>
      <h2 class="text-2xl font-bold text-text mb-2">Απαιτείται Pro</h2>
      <p class="text-text-muted mb-6">Χρειάζεστε συνδρομή Pro για πιστοποιητικό.</p>
      <div class="flex flex-col gap-3">
        <a href={`/${locale}/pricing`} class="px-6 py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity text-center">Αναβάθμιση σε Pro →</a>
        <button onclick="document.getElementById('cert-upgrade-modal').classList.add('hidden')" class="px-6 py-3 border border-primary/30 text-primary rounded-xl font-medium hover:bg-primary/10 transition-all">Αργότερα</button>
      </div>
    </div>
  </div>

  <div id="incomplete-quizzes-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm">
    <div class="bg-surface-card rounded-2xl border border-primary/10 p-8 max-w-lg mx-4 text-center animate-fade-in">
      <div class="text-6xl mb-4">📝</div>
      <h2 class="text-2xl font-bold text-text mb-2">Ολοκληρώστε τα Τεστ</h2>
      <p class="text-text-muted mb-4">Πρέπει να περάσετε όλα τα τεστ με 80%+.</p>
      <div id="incomplete-list" class="text-left mb-6 space-y-2"></div>
      <button onclick="document.getElementById('incomplete-quizzes-modal').classList.add('hidden')" class="px-6 py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity">Το κατάλαβα!</button>
    </div>
  </div>

  <Footer locale={locale} translations={t} />

  <script>
    import { supabase } from '../../lib/supabase';

    async function loadDashboard() {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) { window.location.href = '/el/login'; return; }
      const user = session.user;

      // Fetch profile
      const { data: profile } = await supabase.from('profiles').select('*').eq('id', user.id).single();

      // Fetch progress
      const { data: progress } = await supabase.from('lesson_progress').select('*').eq('user_id', user.id);
      const { data: points } = await supabase.from('user_points').select('*').eq('user_id', user.id).single();

      // Update points
      const totalPoints = document.getElementById('total-points');
      if (totalPoints && points) totalPoints.textContent = String(points.total_points || 0);

      const streak = document.getElementById('current-streak');
      if (streak && points) streak.textContent = `${points.current_streak || 0}`;

      // Calculate module progress
      const moduleLessons = [8, 7, 6, 5, 5, 4];
      let totalCompleted = 0;
      let modulesCompleted = 0;

      for (let m = 1; m <= 6; m++) {
        const moduleProgress = progress?.filter(p => p.module_number === m) || [];
        const completed = moduleProgress.filter(p => p.status === 'completed').length;
        const total = moduleLessons[m - 1];
        const percent = Math.round((completed / total) * 100);
        const bar = document.querySelector(`[data-module-bar="${m}"]`);
        const label = document.querySelector(`[data-module-progress="${m}"]`);
        if (bar) bar.style.width = `${percent}%`;
        if (label) label.textContent = `${percent}%`;
        totalCompleted += completed;
        if (percent === 100) modulesCompleted++;
      }

      const lessonsEl = document.getElementById('lessons-completed');
      const modulesEl = document.getElementById('modules-completed');
      if (lessonsEl) lessonsEl.textContent = `${totalCompleted}/35`;
      if (modulesEl) modulesEl.textContent = `${modulesCompleted}/6`;
    }

    loadDashboard();

    // Quiz tracking
    async function loadQuizData() {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) return;
      const { data: scores } = await supabase.from('quiz_scores').select('*').eq('user_id', session.user.id);
      const names = ['Θεμέλια Δικτύων', 'Πρόσβαση Δικτύου', 'Συνδεσιμότητα IP', 'Υπηρεσίες IP', 'Θεμέλια Ασφάλειας', 'Αυτοματοποίηση'];
      let passedCount = 0;
      for (let m = 1; m <= 6; m++) {
        const ms = scores?.filter(s => s.module_number === m) || [];
        const best = ms.length > 0 ? Math.max(...ms.map(s => Number(s.score))) : 0;
        const passed = best >= 80;
        if (passed) passedCount++;
        const badge = document.querySelector(`[data-quiz-badge="${m}"]`);
        if (badge) { badge.textContent = passed ? '✓' : ms.length > 0 ? '✗' : String(m); badge.className = passed ? 'w-8 h-8 rounded-lg bg-success/20 text-success flex items-center justify-center text-sm font-bold' : ms.length > 0 ? 'w-8 h-8 rounded-lg bg-warning/20 text-warning flex items-center justify-center text-sm font-bold' : 'w-8 h-8 rounded-lg bg-surface flex items-center justify-center text-sm font-bold text-text-muted'; }
        const scoreEl = document.querySelector(`[data-quiz-score="${m}"]`);
        if (scoreEl && ms.length > 0) { scoreEl.textContent = `Καλύτερο: ${Math.round(best)}% ${passed ? '✓' : '(χρειάζεται 80%)'}`; scoreEl.className = passed ? 'text-xs text-success' : 'text-xs text-warning'; }
      }
      const badge = document.getElementById('quiz-progress-badge');
      if (badge) { badge.textContent = `${passedCount}/6 ολοκληρώθηκαν`; if (passedCount === 6) badge.className = 'px-4 py-2 rounded-full bg-success/10 text-success text-sm font-medium'; }
      return { passedCount, scores };
    }
    loadQuizData();

    // Certificate button
    document.getElementById('certificate-btn')?.addEventListener('click', async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) { window.location.href = '/el/login'; return; }
      const { data: profile } = await supabase.from('profiles').select('plan').eq('id', session.user.id).single();
      if (profile?.plan !== 'pro') { document.getElementById('cert-upgrade-modal')?.classList.remove('hidden'); return; }
      const quizData = await loadQuizData();
      if (!quizData || quizData.passedCount < 6) {
        const list = document.getElementById('incomplete-list');
        if (list) {
          const names = ['Θεμέλια Δικτύων', 'Πρόσβαση Δικτύου', 'Συνδεσιμότητα IP', 'Υπηρεσίες IP', 'Θεμέλια Ασφάλειας', 'Αυτοματοποίηση'];
          let html = '';
          for (let m = 1; m <= 6; m++) {
            const ms = quizData?.scores?.filter(s => s.module_number === m) || [];
            const best = ms.length > 0 ? Math.max(...ms.map(s => Number(s.score))) : 0;
            const passed = best >= 80;
            html += `<div class="flex items-center justify-between p-2 rounded-lg ${passed ? 'bg-success/5' : 'bg-warning/5'}"><span class="text-sm text-text">Ενότητα ${m}: ${names[m-1]}</span><span class="text-sm ${passed ? 'text-success' : 'text-warning'}">${passed ? '✓' : ms.length > 0 ? Math.round(best) + '%' : 'Δεν δοκιμάστηκε'}</span></div>`;
          }
          list.innerHTML = html;
        }
        document.getElementById('incomplete-quizzes-modal')?.classList.remove('hidden');
        return;
      }
      alert('Το πιστοποιητικό θα δημιουργηθεί σύντομα!');
    });

    // Upgrade button handler
    document.getElementById('upgrade-btn')?.addEventListener('click', async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) { window.location.href = '/el/login'; return; }
      const { data: profile } = await supabase.from('profiles').select('plan').eq('id', session.user.id).single();
      if (profile?.plan === 'pro') {
        document.getElementById('already-pro-modal')?.classList.remove('hidden');
      } else {
        window.location.href = '/el/pricing';
      }
    });

    // Real-time subscriptions
    const userId = localStorage.getItem('userId');
    if (userId) {
      supabase.channel('el-progress').on('postgres_changes', { event: '*', schema: 'public', table: 'lesson_progress', filter: `user_id=eq.${userId}` }, () => loadDashboard()).subscribe();
      supabase.channel('el-scores').on('postgres_changes', { event: '*', schema: 'public', table: 'quiz_scores', filter: `user_id=eq.${userId}` }, () => loadDashboard()).subscribe();
      supabase.channel('el-points').on('postgres_changes', { event: '*', schema: 'public', table: 'user_points', filter: `user_id=eq.${userId}` }, () => loadDashboard()).subscribe();
    }
  </script>
</BaseLayout>

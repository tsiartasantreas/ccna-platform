---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.tsx';
import Footer from '../../components/layout/Footer.tsx';
import el from '../../i18n/el.json';

const locale = 'el' as const;
const t = el;
---

<BaseLayout title="Επαναφορά Κωδικού" lang={locale}>
  <Header locale={locale} translations={t} client:load />

  <main class="pt-24 pb-16 min-h-screen flex items-center justify-center">
    <div class="w-full max-w-md mx-auto px-4">
      <div class="bg-surface-card rounded-2xl border border-primary/10 p-8">
        <div class="text-center mb-8">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-primary to-accent flex items-center justify-center text-white font-bold text-3xl mx-auto mb-4">NL</div>
          <h1 class="text-2xl font-bold text-text">Επαναφορά Κωδικού</h1>
          <p class="text-sm text-text-muted mt-2">Εισάγετε τον νέο σας κωδικό παρακάτω</p>
        </div>

        <form id="reset-form" class="space-y-5">
          <div>
            <label for="new-password" class="block text-sm font-medium text-text mb-2">Νέος Κωδικός</label>
            <input type="password" id="new-password" required class="w-full px-4 py-3 bg-surface border border-primary/10 rounded-xl text-text placeholder-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="••••••••" />
            <div id="password-requirements" class="mt-3 space-y-1">
              <p id="req-length" class="text-xs text-text-muted flex items-center gap-2"><span class="w-4 h-4 rounded-full border border-text-muted flex items-center justify-center text-[10px]">✗</span>Τουλάχιστον 8 χαρακτήρες</p>
              <p id="req-upper" class="text-xs text-text-muted flex items-center gap-2"><span class="w-4 h-4 rounded-full border border-text-muted flex items-center justify-center text-[10px]">✗</span>Τουλάχιστον 1 κεφαλαίο</p>
              <p id="req-lower" class="text-xs text-text-muted flex items-center gap-2"><span class="w-4 h-4 rounded-full border border-text-muted flex items-center justify-center text-[10px]">✗</span>Τουλάχιστον 1 πεζό</p>
              <p id="req-number" class="text-xs text-text-muted flex items-center gap-2"><span class="w-4 h-4 rounded-full border border-text-muted flex items-center justify-center text-[10px]">✗</span>Τουλάχιστον 1 αριθμό</p>
              <p id="req-special" class="text-xs text-text-muted flex items-center gap-2"><span class="w-4 h-4 rounded-full border border-text-muted flex items-center justify-center text-[10px]">✗</span>Τουλάχιστον 1 ειδικός χαρακτήρας</p>
            </div>
          </div>
          <div>
            <label for="confirm-password" class="block text-sm font-medium text-text mb-2">Επιβεβαίωση Κωδικού</label>
            <input type="password" id="confirm-password" required class="w-full px-4 py-3 bg-surface border border-primary/10 rounded-xl text-text placeholder-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="••••••••" />
            <p id="match-error" class="hidden text-xs text-error mt-1">Οι κωδικοί δεν ταιριάζουν</p>
          </div>
          <button type="submit" id="submit-btn" disabled class="w-full py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity disabled:opacity-30 disabled:cursor-not-allowed">
            Επαναφορά Κωδικού
          </button>
        </form>

        <div id="success-message" class="hidden text-center">
          <div class="text-6xl mb-4">✅</div>
          <h2 class="text-2xl font-bold text-text mb-2">Επιτυχής Επαναφορά!</h2>
          <p class="text-text-muted mb-6">Ο κωδικός σας ενημερώθηκε. Μπορείτε τώρα να συνδεθείτε.</p>
          <a href={`/${locale}/login`} class="inline-flex px-6 py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity">Σύνδεση →</a>
        </div>

        <div id="error-message" class="hidden text-center">
          <div class="text-6xl mb-4">❌</div>
          <h2 class="text-2xl font-bold text-text mb-2">Αποτυχία</h2>
          <p class="text-text-muted mb-6" id="error-text">Ο σύνδεσμος δεν είναι έγκυρος έχει λήξει.</p>
          <a href={`/${locale}/login`} class="inline-flex px-6 py-3 bg-primary/10 text-primary rounded-xl font-medium hover:bg-primary/20 transition-colors">Επιστροφή στη Σύνδεση</a>
        </div>
      </div>
    </div>
  </main>

  <Footer locale={locale} translations={t} />

  <script>
    import { createClient } from '@supabase/supabase-js';
    const supabase = createClient('https://jhesstimsojwmkdysmpy.supabase.co', 'sb_publishable_bKD9biIulcfC5iNipD-8IA_3Zu4bmWD');

    const form = document.getElementById('reset-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const newPass = document.getElementById('new-password') as HTMLInputElement;
    const confirmPass = document.getElementById('confirm-password') as HTMLInputElement;
    const successMsg = document.getElementById('success-message');
    const errorMsg = document.getElementById('error-message');
    const errorText = document.getElementById('error-text');
    const matchError = document.getElementById('match-error');

    function updateRequirements(pw: string) {
      const checks = { length: pw.length >= 8, upper: /[A-Z]/.test(pw), lower: /[a-z]/.test(pw), number: /[0-9]/.test(pw), special: /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(pw) };
      ['length','upper','lower','number','special'].forEach(key => {
        const el = document.getElementById(`req-${key}`);
        if (el) {
          const span = el.querySelector('span');
          if (span) { span.textContent = checks[key] ? '✓' : '✗'; span.className = checks[key] ? 'w-4 h-4 rounded-full bg-success text-white flex items-center justify-center text-[10px]' : 'w-4 h-4 rounded-full border border-text-muted flex items-center justify-center text-[10px]'; }
          el.className = checks[key] ? 'text-xs text-success flex items-center gap-2' : 'text-xs text-text-muted flex items-center gap-2';
        }
      });
      const allMet = Object.values(checks).every(Boolean);
      const match = newPass.value === confirmPass.value && confirmPass.value.length > 0;
      submitBtn.disabled = !(allMet && match);
      if (confirmPass.value.length > 0 && !match) matchError?.classList.remove('hidden');
      else matchError?.classList.add('hidden');
    }

    newPass?.addEventListener('input', () => updateRequirements(newPass.value));
    confirmPass?.addEventListener('input', () => updateRequirements(newPass.value));

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (newPass.value !== confirmPass.value) { matchError?.classList.remove('hidden'); return; }
      submitBtn.disabled = true; submitBtn.textContent = 'Ενημέρωση...';
      try {
        const { error } = await supabase.auth.updateUser({ password: newPass.value });
        if (error) throw error;
        form.classList.add('hidden'); successMsg?.classList.remove('hidden');
      } catch (err: any) {
        form.classList.add('hidden'); errorMsg?.classList.remove('hidden');
        if (errorText) errorText.textContent = err.message || 'Ο σύνδεσμος δεν είναι έγκυρος.';
      }
    });
  </script>
</BaseLayout>

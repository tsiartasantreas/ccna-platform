---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.tsx';
import Footer from '../../components/layout/Footer.tsx';
import el from '../../i18n/el.json';

const locale = 'el';
const t = el;
---

<BaseLayout title={t.pricing.title} description={t.pricing.subtitle} lang={locale}>
  <Header locale={locale} translations={t} client:load />

  <main class="pt-24 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h1 class="text-4xl sm:text-5xl font-bold mb-4">{t.pricing.title}</h1>
        <p class="text-text-muted max-w-2xl mx-auto text-lg">{t.pricing.subtitle}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {/* Free Plan */}
        <div class="bg-surface-card rounded-2xl border border-primary/10 p-8">
          <div class="mb-6">
            <h3 class="text-2xl font-bold text-text mb-2">{t.pricing.free}</h3>
            <div class="flex items-baseline gap-1">
              <span class="text-5xl font-bold text-text">€0</span>
              <span class="text-text-muted">{t.pricing.per_month}</span>
            </div>
          </div>
          <ul class="space-y-4 mb-8">
            {['Και τα 35 μαθήματα', 'Κείμενο & διαγράμματα', '3D διαδραστικά στοιχεία', 'Βασική αξιολόγηση', 'Παρακολούθηση προόδου', 'Σκοτεινό/Φωτεινό θέμα', 'Ελληνικά & Αγγλικά'].map((f) => (
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-success flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M5 13l4 4L19 7" /></svg>
                <span class="text-text-muted">{f}</span>
              </li>
            ))}
          </ul>
          <a href={`/${locale}/login?mode=signup`} class="block w-full text-center px-6 py-3 border border-primary/30 text-primary rounded-xl font-medium hover:bg-primary/10 transition-all">
            Ξεκινήστε Δωρεάν
          </a>
        </div>

        {/* Pro Plan */}
        <div class="relative bg-surface-card rounded-2xl border-2 border-primary p-8 shadow-lg shadow-primary/10">
          <div class="absolute -top-4 left-1/2 -translate-x-1/2 px-4 py-1 bg-gradient-to-r from-primary to-accent text-white text-sm font-medium rounded-full">
            Δημοφιλές
          </div>
          <div class="mb-6">
            <h3 class="text-2xl font-bold text-text mb-2">{t.pricing.pro}</h3>
            <div class="flex items-baseline gap-1">
              <span class="text-5xl font-bold bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent">€1.99</span>
              <span class="text-text-muted">{t.pricing.per_month}</span>
            </div>
            <p class="text-sm text-text-muted mt-2">ή €19.99/έτος — <span class="text-success font-medium">{t.pricing.save}</span></p>
          </div>
          <ul class="space-y-4 mb-8">
            {['Τα πάντα στο Δωρεάν, συν:', 'Πλήρη gamified τεστ (80+ ερωτήσεις)', 'Πολλαπλή επιλογή, drag & drop, CLI', 'Πόντοι, σερί & επιτεύγματα', 'Πιστοποιητικό ολοκλήρωσης (PDF)', 'Προτεραιότητα υποστήριξης'].map((f) => (
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M5 13l4 4L19 7" /></svg>
                <span class="text-text">{f}</span>
              </li>
            ))}
          </ul>
          <a href={`/${locale}/login?mode=signup`} class="block w-full text-center px-6 py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-all shadow-lg shadow-primary/25">
            {t.pricing.upgrade} →
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer locale={locale} translations={t} />
</BaseLayout>

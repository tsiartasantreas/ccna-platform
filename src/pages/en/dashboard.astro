---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.tsx';
import Footer from '../../components/layout/Footer.tsx';
import en from '../../i18n/en.json';

const locale = 'en' as const;
const t = en;

const modules = [
  { num: 1, name: 'Network Fundamentals', lessons: 8, weight: '20%', color: 'from-blue-500 to-cyan-500', icon: '🌐' },
  { num: 2, name: 'Network Access', lessons: 7, weight: '20%', color: 'from-purple-500 to-pink-500', icon: '🔌' },
  { num: 3, name: 'IP Connectivity', lessons: 6, weight: '25%', color: 'from-green-500 to-emerald-500', icon: '🛤️' },
  { num: 4, name: 'IP Services', lessons: 5, weight: '10%', color: 'from-orange-500 to-red-500', icon: '⚙️' },
  { num: 5, name: 'Security Fundamentals', lessons: 5, weight: '15%', color: 'from-red-500 to-rose-500', icon: '🔒' },
  { num: 6, name: 'Automation & Programmability', lessons: 4, weight: '10%', color: 'from-indigo-500 to-violet-500', icon: '🤖' },
];
---

<BaseLayout title={t.dashboard.welcome} lang={locale}>
  <Header locale={locale} translations={t} client:load />

  <main class="pt-24 pb-16 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-bold mb-2">{t.dashboard.welcome} 👋</h1>
        <p class="text-text-muted" id="user-greeting">{t.dashboard.your_progress}</p>
      </div>

      {/* Stats Cards */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-xl">🎯</div>
            <span class="text-sm text-text-muted">{t.dashboard.total_points}</span>
          </div>
          <div class="text-3xl font-bold text-primary" id="total-points">0</div>
        </div>
        <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-xl">🔥</div>
            <span class="text-sm text-text-muted">{t.dashboard.current_streak}</span>
          </div>
          <div class="text-3xl font-bold text-accent" id="current-streak">0 days</div>
        </div>
        <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg bg-success/10 flex items-center justify-center text-xl">📚</div>
            <span class="text-sm text-text-muted">{t.dashboard.modules_completed}</span>
          </div>
          <div class="text-3xl font-bold text-success" id="modules-completed">0/6</div>
        </div>
        <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg bg-warning/10 flex items-center justify-center text-xl">📝</div>
            <span class="text-sm text-text-muted">{t.dashboard.lessons_completed}</span>
          </div>
          <div class="text-3xl font-bold text-warning" id="lessons-completed">0/35</div>
        </div>
      </div>

      {/* Plan Status */}
      <div class="bg-surface-card rounded-xl border border-primary/10 p-6 mb-8">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary to-accent flex items-center justify-center text-white font-bold text-lg" id="plan-icon">F</div>
            <div>
              <div class="font-bold text-text" id="plan-name">Free Plan</div>
              <div class="text-sm text-text-muted" id="plan-desc">Basic access to all lessons</div>
            </div>
          </div>
          <a href={`/${locale}/pricing`} class="px-4 py-2 bg-primary/10 text-primary rounded-lg text-sm font-medium hover:bg-primary/20 transition-colors" id="plan-action">
            Upgrade to Pro
          </a>
        </div>
      </div>

      {/* Module Progress */}
      <div class="mb-8">
        <h2 class="text-2xl font-bold mb-6">{t.dashboard.your_progress}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {modules.map((module) => (
            <div class="bg-surface-card rounded-xl border border-primary/10 p-6 hover:border-primary/20 transition-colors">
              <div class="flex items-center gap-3 mb-4">
                <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${module.color} flex items-center justify-center text-xl`}>
                  {module.icon}
                </div>
                <div>
                  <h3 class="font-bold text-text">{module.name}</h3>
                  <p class="text-xs text-text-muted">{module.lessons} lessons • {module.weight} exam</p>
                </div>
              </div>

              <div class="mb-3">
                <div class="flex items-center justify-between text-sm mb-1">
                  <span class="text-text-muted">Progress</span>
                  <span class="text-primary font-medium" data-module-progress={module.num}>0%</span>
                </div>
                <div class="w-full h-2 bg-surface rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-primary to-accent rounded-full transition-all duration-500"
                    style="width: 0%"
                    data-module-bar={module.num}
                  />
                </div>
              </div>

              <a
                href={`/${locale}/lessons/${module.num}/1`}
                class="block text-center text-sm text-primary hover:underline"
              >
                {t.dashboard.continue_learning} →
              </a>
            </div>
          ))}
        </div>
      </div>

      {/* Quick Actions */}
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href={`/${locale}/curriculum`} class="bg-gradient-to-r from-primary/10 to-accent/10 rounded-xl border border-primary/20 p-6 hover:border-primary/40 transition-colors">
          <div class="text-2xl mb-2">📖</div>
          <h3 class="font-bold text-text mb-1">Browse Curriculum</h3>
          <p class="text-sm text-text-muted">View all 35 lessons across 6 modules</p>
        </a>
        <a href={`/${locale}/pricing`} class="bg-gradient-to-r from-accent/10 to-primary/10 rounded-xl border border-accent/20 p-6 hover:border-accent/40 transition-colors">
          <div class="text-2xl mb-2">⭐</div>
          <h3 class="font-bold text-text mb-1">Upgrade to Pro</h3>
          <p class="text-sm text-text-muted">Unlock gamified quizzes and certificates</p>
        </a>
      </div>
    </div>
  </main>

  <Footer locale={locale} translations={t} />

  <script>
    import { createClient } from '@supabase/supabase-js';

    const supabase = createClient(
      'https://jhesstimsojwmkdysmpy.supabase.co',
      'sb_publishable_bKD9biIulcfC5iNipD-8IA_3Zu4bmWD'
    );

    async function loadDashboard() {
      const { data: { session } } = await supabase.auth.getSession();

      if (!session?.user) {
        window.location.href = '/en/login';
        return;
      }

      const user = session.user;
      const userName = user.user_metadata?.display_name || user.email?.split('@')[0] || 'User';

      // Update greeting
      const greeting = document.getElementById('user-greeting');
      if (greeting) greeting.textContent = `Welcome back, ${userName}! Here's your learning progress.`;

      // Fetch user profile
      const { data: profile } = await supabase
        .from('profiles')
        .select('*')
        .eq('id', user.id)
        .single();

      // Update plan status
      const planIcon = document.getElementById('plan-icon');
      const planName = document.getElementById('plan-name');
      const planDesc = document.getElementById('plan-desc');
      const planAction = document.getElementById('plan-action');

      if (profile?.plan === 'pro') {
        if (planIcon) { planIcon.textContent = 'P'; planIcon.className = 'w-12 h-12 rounded-xl bg-gradient-to-br from-accent to-primary flex items-center justify-center text-white font-bold text-lg'; }
        if (planName) planName.textContent = 'Pro Plan';
        if (planDesc) planDesc.textContent = 'Full access to quizzes, certificates, and more';
        if (planAction) { planAction.textContent = 'Active'; planAction.className = 'px-4 py-2 bg-success/10 text-success rounded-lg text-sm font-medium cursor-default'; }
      }

      // Fetch lesson progress
      const { data: progress } = await supabase
        .from('lesson_progress')
        .select('*')
        .eq('user_id', user.id);

      // Also load from localStorage
      const localCompleted = JSON.parse(localStorage.getItem('completedLessons') || '{}');

      // Fetch quiz scores
      const { data: scores } = await supabase
        .from('quiz_scores')
        .select('*')
        .eq('user_id', user.id);

      // Fetch user points
      const { data: points } = await supabase
        .from('user_points')
        .select('*')
        .eq('user_id', user.id)
        .single();

      // Update points
      const totalPoints = document.getElementById('total-points');
      if (totalPoints && points) totalPoints.textContent = String(points.total_points || 0);

      // Update streak
      const streak = document.getElementById('current-streak');
      if (streak && points) streak.textContent = `${points.current_streak || 0} days`;

      // Calculate module progress (merge Supabase + localStorage)
      const moduleLessons = [8, 7, 6, 5, 5, 4];
      let totalCompleted = 0;
      let modulesCompleted = 0;

      for (let m = 1; m <= 6; m++) {
        const moduleProgress = progress?.filter(p => p.module_number === m) || [];
        const supabaseCompleted = moduleProgress.filter(p => p.status === 'completed').length;
        // Also count localStorage completions
        let localCompleted = 0;
        for (let l = 1; l <= moduleLessons[m - 1]; l++) {
          if (localCompleted[`${m}_${l}`]) localCompleted++;
        }
        const completed = Math.max(supabaseCompleted, localCompleted);
        const total = moduleLessons[m - 1];
        const percent = Math.round((completed / total) * 100);

        const bar = document.querySelector(`[data-module-bar="${m}"]`) as HTMLElement;
        const label = document.querySelector(`[data-module-progress="${m}"]`);
        if (bar) bar.style.width = `${percent}%`;
        if (label) label.textContent = `${percent}%`;

        totalCompleted += completed;
        if (percent === 100) modulesCompleted++;
      }

      // Update totals
      const lessonsEl = document.getElementById('lessons-completed');
      const modulesEl = document.getElementById('modules-completed');
      if (lessonsEl) lessonsEl.textContent = `${totalCompleted}/35`;
      if (modulesEl) modulesEl.textContent = `${modulesCompleted}/6`;
    }

    loadDashboard();

    // Real-time subscriptions for live updates
    const userId = localStorage.getItem('userId');
    if (userId) {
      // Subscribe to lesson progress changes
      supabase
        .channel('lesson-progress-changes')
        .on('postgres_changes', {
          event: '*',
          schema: 'public',
          table: 'lesson_progress',
          filter: `user_id=eq.${userId}`,
        }, () => {
          // Reload dashboard when progress changes
          loadDashboard();
        })
        .subscribe();

      // Subscribe to quiz score changes
      supabase
        .channel('quiz-score-changes')
        .on('postgres_changes', {
          event: '*',
          schema: 'public',
          table: 'quiz_scores',
          filter: `user_id=eq.${userId}`,
        }, () => {
          loadDashboard();
        })
        .subscribe();

      // Subscribe to points changes
      supabase
        .channel('points-changes')
        .on('postgres_changes', {
          event: '*',
          schema: 'public',
          table: 'user_points',
          filter: `user_id=eq.${userId}`,
        }, () => {
          loadDashboard();
        })
        .subscribe();
    }
  </script>
</BaseLayout>

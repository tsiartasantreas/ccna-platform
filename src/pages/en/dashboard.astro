---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.tsx';
import Footer from '../../components/layout/Footer.tsx';
import en from '../../i18n/en.json';

const locale = 'en' as const;
const t = en;

const modules = [
  { num: 1, name: 'Network Fundamentals', lessons: 8, weight: '20%', color: 'from-blue-500 to-cyan-500', icon: '🌐' },
  { num: 2, name: 'Network Access', lessons: 7, weight: '20%', color: 'from-purple-500 to-pink-500', icon: '🔌' },
  { num: 3, name: 'IP Connectivity', lessons: 6, weight: '25%', color: 'from-green-500 to-emerald-500', icon: '🛤️' },
  { num: 4, name: 'IP Services', lessons: 5, weight: '10%', color: 'from-orange-500 to-red-500', icon: '⚙️' },
  { num: 5, name: 'Security Fundamentals', lessons: 5, weight: '15%', color: 'from-red-500 to-rose-500', icon: '🔒' },
  { num: 6, name: 'Automation & Programmability', lessons: 4, weight: '10%', color: 'from-indigo-500 to-violet-500', icon: '🤖' },
];
---

<BaseLayout title={t.dashboard.welcome} lang={locale}>
  <Header locale={locale} translations={t} client:load />

  <main class="pt-24 pb-16 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-bold mb-2">{t.dashboard.welcome} 👋</h1>
        <p class="text-text-muted" id="user-greeting">{t.dashboard.your_progress}</p>
      </div>

      {/* Stats Cards */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-xl">🎯</div>
            <span class="text-sm text-text-muted">{t.dashboard.total_points}</span>
          </div>
          <div class="text-3xl font-bold text-primary" id="total-points">0</div>
        </div>
        <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-xl">🔥</div>
            <span class="text-sm text-text-muted">{t.dashboard.current_streak}</span>
          </div>
          <div class="text-3xl font-bold text-accent" id="current-streak">0 days</div>
        </div>
        <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg bg-success/10 flex items-center justify-center text-xl">📚</div>
            <span class="text-sm text-text-muted">{t.dashboard.modules_completed}</span>
          </div>
          <div class="text-3xl font-bold text-success" id="modules-completed">0/6</div>
        </div>
        <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg bg-warning/10 flex items-center justify-center text-xl">📝</div>
            <span class="text-sm text-text-muted">{t.dashboard.lessons_completed}</span>
          </div>
          <div class="text-3xl font-bold text-warning" id="lessons-completed">0/35</div>
        </div>
      </div>

      {/* Plan Status */}
      <div class="bg-surface-card rounded-xl border border-primary/10 p-6 mb-8">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary to-accent flex items-center justify-center text-white font-bold text-lg" id="plan-icon">F</div>
            <div>
              <div class="font-bold text-text" id="plan-name">Free Plan</div>
              <div class="text-sm text-text-muted" id="plan-desc">Basic access to all lessons</div>
            </div>
          </div>
          <a href={`/${locale}/pricing`} class="px-4 py-2 bg-primary/10 text-primary rounded-lg text-sm font-medium hover:bg-primary/20 transition-colors" id="plan-action">
            Upgrade to Pro
          </a>
        </div>
      </div>

      {/* Module Progress */}
      <div class="mb-8">
        <h2 class="text-2xl font-bold mb-6">{t.dashboard.your_progress}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {modules.map((module) => (
            <div class="bg-surface-card rounded-xl border border-primary/10 p-6 hover:border-primary/20 transition-colors">
              <div class="flex items-center gap-3 mb-4">
                <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${module.color} flex items-center justify-center text-xl`}>
                  {module.icon}
                </div>
                <div>
                  <h3 class="font-bold text-text">{module.name}</h3>
                  <p class="text-xs text-text-muted">{module.lessons} lessons • {module.weight} exam</p>
                </div>
              </div>

              <div class="mb-3">
                <div class="flex items-center justify-between text-sm mb-1">
                  <span class="text-text-muted">Progress</span>
                  <span class="text-primary font-medium" data-module-progress={module.num}>0%</span>
                </div>
                <div class="w-full h-2 bg-surface rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-primary to-accent rounded-full transition-all duration-500"
                    style="width: 0%"
                    data-module-bar={module.num}
                  />
                </div>
              </div>

              <a
                href={`/${locale}/lessons/${module.num}/1`}
                class="block text-center text-sm text-primary hover:underline"
              >
                {t.dashboard.continue_learning} →
              </a>
            </div>
          ))}
        </div>
      </div>

      {/* Quiz & Certificate Section */}
      <div class="mb-8">
        <h2 class="text-2xl font-bold mb-6">🎯 Quiz & Certification</h2>
        <div class="bg-surface-card rounded-2xl border border-primary/10 p-6 mb-6">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h3 class="text-lg font-bold text-text">Module Quizzes</h3>
              <p class="text-sm text-text-muted">Complete all quizzes with 80%+ to earn your certificate</p>
            </div>
            <div id="quiz-progress-badge" class="px-4 py-2 rounded-full bg-surface-light text-text-muted text-sm font-medium">
              0/6 completed
            </div>
          </div>

          <div id="quiz-list" class="space-y-3 mb-6">
            {[
              { num: 1, name: 'Network Fundamentals' },
              { num: 2, name: 'Network Access' },
              { num: 3, name: 'IP Connectivity' },
              { num: 4, name: 'IP Services' },
              { num: 5, name: 'Security Fundamentals' },
              { num: 6, name: 'Automation & Programmability' },
            ].map((mod) => (
              <div class="flex items-center justify-between p-3 bg-surface-light rounded-lg" data-quiz-row={mod.num}>
                <div class="flex items-center gap-3">
                  <span class="w-8 h-8 rounded-lg bg-surface flex items-center justify-center text-sm font-bold text-text-muted" data-quiz-badge={mod.num}>
                    {mod.num}
                  </span>
                  <div>
                    <div class="font-medium text-text text-sm">Module {mod.num}: {mod.name}</div>
                    <div class="text-xs text-text-muted" data-quiz-score={mod.num}>Not attempted</div>
                  </div>
                </div>
                <a href={`/${locale}/lessons/${mod.num}/quiz`} class="text-xs text-primary hover:underline">Take Quiz →</a>
              </div>
            ))}
          </div>

          {/* Certificate Button */}
          <button
            id="certificate-btn"
            class="w-full py-4 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity flex items-center justify-center gap-2"
          >
            🎓 Generate Certificate
          </button>
        </div>

        {/* Recent Quiz Scores */}
        <div class="bg-surface-card rounded-2xl border border-primary/10 p-6 mt-6">
          <h3 class="text-lg font-bold text-text mb-4">📊 Recent Quiz Scores</h3>
          <div id="recent-scores" class="space-y-3">
            <p class="text-text-muted text-sm">No quiz attempts yet.</p>
          </div>
        </div>
      </div>

      {/* Quick Actions */}
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href={`/${locale}/curriculum`} class="bg-gradient-to-r from-primary/10 to-accent/10 rounded-xl border border-primary/20 p-6 hover:border-primary/40 transition-colors">
          <div class="text-2xl mb-2">📖</div>
          <h3 class="font-bold text-text mb-1">Browse Curriculum</h3>
          <p class="text-sm text-text-muted">View all 35 lessons across 6 modules</p>
        </a>
        <button id="upgrade-btn" class="bg-gradient-to-r from-accent/10 to-primary/10 rounded-xl border border-accent/20 p-6 hover:border-accent/40 transition-colors text-left cursor-pointer">
          <div class="text-2xl mb-2">⭐</div>
          <h3 class="font-bold text-text mb-1">Upgrade to Pro</h3>
          <p class="text-sm text-text-muted">Unlock gamified quizzes and certificates</p>
        </button>
      </div>
    </div>
  </main>

  {/* Already Pro Modal */}
  <div id="already-pro-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm">
    <div class="bg-surface-card rounded-2xl border border-primary/10 p-8 max-w-md mx-4 text-center animate-fade-in">
      <div class="text-6xl mb-4">⭐</div>
      <h2 class="text-2xl font-bold text-text mb-2">You're Already Pro!</h2>
      <p class="text-text-muted mb-6">You have full access to all quizzes, certificates, and premium features.</p>
      <button onclick="document.getElementById('already-pro-modal').classList.add('hidden')" class="px-6 py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity">
        Got it!
      </button>
    </div>
  </div>

  {/* Upgrade to Pro for Certificate Modal */}
  <div id="cert-upgrade-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm">
    <div class="bg-surface-card rounded-2xl border border-primary/10 p-8 max-w-md mx-4 text-center animate-fade-in">
      <div class="text-6xl mb-4">🔒</div>
      <h2 class="text-2xl font-bold text-text mb-2">Pro Required</h2>
      <p class="text-text-muted mb-6">You need a Pro subscription to generate your completion certificate.</p>
      <div class="flex flex-col gap-3">
        <a href={`/${locale}/pricing`} class="px-6 py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity text-center">
          Upgrade to Pro →
        </a>
        <button onclick="document.getElementById('cert-upgrade-modal').classList.add('hidden')" class="px-6 py-3 border border-primary/30 text-primary rounded-xl font-medium hover:bg-primary/10 transition-all">
          Maybe Later
        </button>
      </div>
    </div>
  </div>

  {/* Incomplete Quizzes Modal */}
  <div id="incomplete-quizzes-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm">
    <div class="bg-surface-card rounded-2xl border border-primary/10 p-8 max-w-lg mx-4 text-center animate-fade-in">
      <div class="text-6xl mb-4">📝</div>
      <h2 class="text-2xl font-bold text-text mb-2">Complete All Quizzes</h2>
      <p class="text-text-muted mb-4">You need to pass all 6 module quizzes with 80%+ to earn your certificate.</p>
      <div id="incomplete-list" class="text-left mb-6 space-y-2"></div>
      <button onclick="document.getElementById('incomplete-quizzes-modal').classList.add('hidden')" class="px-6 py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity">
        Got it!
      </button>
    </div>
  </div>

  <Footer locale={locale} translations={t} />

  <script>
    import { supabase } from '../../lib/supabase';

    // Store dashboard data globally for other handlers
    let currentUserData: any = null;

    async function loadDashboard() {
      const { data: { session } } = await supabase.auth.getSession();

      if (!session?.user) {
        window.location.href = '/en/login';
        return;
      }

      const user = session.user;
      const userName = user.user_metadata?.display_name || user.email?.split('@')[0] || 'User';

      // Update greeting
      const greeting = document.getElementById('user-greeting');
      if (greeting) greeting.textContent = `Welcome back, ${userName}! Here's your learning progress.`;

      // Sync localStorage completions to database first
      const localCompleted = JSON.parse(localStorage.getItem(`completedLessons_${user.id}`) || '{}');
      const syncErrors: string[] = [];
      for (const key of Object.keys(localCompleted)) {
        const [m, l] = key.split('_').map(Number);
        if (m && l) {
          const { error } = await supabase.rpc('user_complete_lesson', { p_module_number: m, p_lesson_number: l });
          if (error) {
            console.error(`Sync failed for lesson ${m}_${l}:`, error);
            syncErrors.push(`${m}_${l}`);
          }
        }
      }
      if (syncErrors.length > 0) {
        console.warn('Failed to sync these lessons to database:', syncErrors);
      }

      // Fetch ALL user data via secure RPC (bypasses RLS, uses auth.uid() server-side)
      const { data: dashboardData, error: dashboardError } = await supabase.rpc('user_get_dashboard_data');

      if (dashboardError) {
        console.error('Dashboard data fetch error:', dashboardError);
        return;
      }

      // Store for other handlers
      currentUserData = dashboardData;

      const profile = dashboardData?.profile;
      const progress = dashboardData?.lesson_progress || [];
      const scores = dashboardData?.quiz_scores || [];
      const points = dashboardData?.user_points;

      // Update plan status
      const planIcon = document.getElementById('plan-icon');
      const planName = document.getElementById('plan-name');
      const planDesc = document.getElementById('plan-desc');
      const planAction = document.getElementById('plan-action');
      const upgradeBtn = document.getElementById('upgrade-btn');

      if (profile?.plan === 'pro') {
        if (planIcon) { planIcon.textContent = 'P'; planIcon.className = 'w-12 h-12 rounded-xl bg-gradient-to-br from-accent to-primary flex items-center justify-center text-white font-bold text-lg'; }
        if (planName) planName.textContent = 'Pro Plan';
        if (planDesc) planDesc.textContent = 'Full access to quizzes, certificates, and more';
        if (planAction) {
          planAction.textContent = 'Active ✓';
          planAction.className = 'px-4 py-2 bg-success/10 text-success rounded-lg text-sm font-medium cursor-default';
          planAction.removeAttribute('href');
          planAction.removeAttribute('onclick');
        }
        // Update upgrade button for Pro users
        if (upgradeBtn) {
          upgradeBtn.innerHTML = `
            <div class="text-2xl mb-2">⭐</div>
            <h3 class="font-bold text-text mb-1">Pro Member</h3>
            <p class="text-sm text-text-muted">You have full access to all features</p>
          `;
          upgradeBtn.className = 'bg-gradient-to-r from-success/10 to-accent/10 rounded-xl border border-success/20 p-6 hover:border-success/40 transition-colors text-left cursor-default';
        }
      }

      // Update points
      const totalPoints = document.getElementById('total-points');
      if (totalPoints && points) totalPoints.textContent = String(points.total_points || 0);

      // Update streak
      const streak = document.getElementById('current-streak');
      if (streak && points) streak.textContent = `${points.current_streak || 0} days`;

      // Calculate module progress (use database only - already synced from localStorage)
      const moduleLessons = [8, 7, 6, 5, 5, 4];
      let totalCompleted = 0;
      let modulesCompleted = 0;

      for (let m = 1; m <= 6; m++) {
        const moduleProgress = progress?.filter((p: any) => p.module_number === m) || [];
        const completed = moduleProgress.filter((p: any) => p.status === 'completed').length;
        const total = moduleLessons[m - 1];
        const percent = Math.round((completed / total) * 100);

        const bar = document.querySelector(`[data-module-bar="${m}"]`) as HTMLElement;
        const label = document.querySelector(`[data-module-progress="${m}"]`);
        if (bar) bar.style.width = `${percent}%`;
        if (label) label.textContent = `${percent}%`;

        totalCompleted += completed;
        if (percent === 100) modulesCompleted++;
      }

      // Update totals
      const lessonsEl = document.getElementById('lessons-completed');
      const modulesEl = document.getElementById('modules-completed');
      if (lessonsEl) lessonsEl.textContent = `${totalCompleted}/35`;
      if (modulesEl) modulesEl.textContent = `${modulesCompleted}/6`;

      // Render recent quiz scores
      const scoresContainer = document.getElementById('recent-scores');
      if (scoresContainer && scores && scores.length > 0) {
        const moduleNames = ['Network Fundamentals', 'Network Access', 'IP Connectivity', 'IP Services', 'Security Fundamentals', 'Automation'];
        scoresContainer.innerHTML = scores.slice(0, 10).map(s => {
          const passed = Number(s.score) >= 80;
          const date = new Date(s.completed_at).toLocaleDateString();
          return `<div class="flex items-center justify-between p-3 bg-surface-light rounded-lg">
            <div>
              <div class="font-medium text-text text-sm">Module ${s.module_number}: ${moduleNames[s.module_number - 1]}</div>
              <div class="text-xs text-text-muted">Attempt #${s.attempt_number} • ${date}</div>
            </div>
            <div class="text-right">
              <div class="text-lg font-bold ${passed ? 'text-success' : 'text-warning'}">${Math.round(Number(s.score))}%</div>
              <div class="text-xs ${passed ? 'text-success' : 'text-text-muted'}">${s.correct_answers}/${s.total_questions}</div>
            </div>
          </div>`;
        }).join('');
      }
    }

    loadDashboard();

    // Quiz tracking - use stored data from RPC
    async function loadQuizData() {
      // Use scores already fetched from user_get_dashboard_data()
      const scores = currentUserData?.quiz_scores || [];

      const moduleNames = ['Network Fundamentals', 'Network Access', 'IP Connectivity', 'IP Services', 'Security Fundamentals', 'Automation & Programmability'];
      let passedCount = 0;

      for (let m = 1; m <= 6; m++) {
        const moduleScores = scores?.filter(s => s.module_number === m) || [];
        const bestScore = moduleScores.length > 0 ? Math.max(...moduleScores.map(s => Number(s.score))) : 0;
        const passed = bestScore >= 80;
        if (passed) passedCount++;

        // Update badge
        const badge = document.querySelector(`[data-quiz-badge="${m}"]`);
        if (badge) {
          if (passed) {
            badge.textContent = '✓';
            badge.className = 'w-8 h-8 rounded-lg bg-success/20 text-success flex items-center justify-center text-sm font-bold';
          } else if (moduleScores.length > 0) {
            badge.textContent = '✗';
            badge.className = 'w-8 h-8 rounded-lg bg-warning/20 text-warning flex items-center justify-center text-sm font-bold';
          }
        }

        // Update score
        const scoreEl = document.querySelector(`[data-quiz-score="${m}"]`);
        if (scoreEl) {
          if (moduleScores.length > 0) {
            scoreEl.textContent = `Best: ${Math.round(bestScore)}% ${passed ? '✓ Passed' : '(need 80%)'}`;
            scoreEl.className = passed ? 'text-xs text-success' : 'text-xs text-warning';
          }
        }
      }

      // Update progress badge
      const progressBadge = document.getElementById('quiz-progress-badge');
      if (progressBadge) {
        progressBadge.textContent = `${passedCount}/6 completed`;
        if (passedCount === 6) {
          progressBadge.className = 'px-4 py-2 rounded-full bg-success/10 text-success text-sm font-medium';
        }
      }

      return { passedCount, scores };
    }

    loadQuizData();

    // Certificate button handler
    document.getElementById('certificate-btn')?.addEventListener('click', async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) {
        window.location.href = '/en/login';
        return;
      }

      // Use stored profile data instead of separate query
      if (currentUserData?.profile?.plan !== 'pro') {
        document.getElementById('cert-upgrade-modal')?.classList.remove('hidden');
        return;
      }

      // Check if all quizzes passed
      const quizData = await loadQuizData();
      if (!quizData || quizData.passedCount < 6) {
        // Show incomplete quizzes modal
        const incompleteList = document.getElementById('incomplete-list');
        if (incompleteList) {
          const moduleNames = ['Network Fundamentals', 'Network Access', 'IP Connectivity', 'IP Services', 'Security Fundamentals', 'Automation & Programmability'];
          let html = '';
          for (let m = 1; m <= 6; m++) {
            const moduleScores = quizData?.scores?.filter(s => s.module_number === m) || [];
            const bestScore = moduleScores.length > 0 ? Math.max(...moduleScores.map(s => Number(s.score))) : 0;
            const passed = bestScore >= 80;
            html += `<div class="flex items-center justify-between p-2 rounded-lg ${passed ? 'bg-success/5' : 'bg-warning/5'}">
              <span class="text-sm text-text">Module ${m}: ${moduleNames[m-1]}</span>
              <span class="text-sm ${passed ? 'text-success' : 'text-warning'}">${passed ? '✓ Passed' : moduleScores.length > 0 ? Math.round(bestScore) + '%' : 'Not attempted'}</span>
            </div>`;
          }
          incompleteList.innerHTML = html;
        }
        document.getElementById('incomplete-quizzes-modal')?.classList.remove('hidden');
        return;
      }

      // Generate certificate
      const userName = session.user.user_metadata?.display_name || session.user.email?.split('@')[0] || 'User';
      const { jsPDF } = await import('jspdf');
      const doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
      const w = doc.internal.pageSize.getWidth();
      const h = doc.internal.pageSize.getHeight();

      try {
        const templateUrl = 'https://raw.githubusercontent.com/tsiartasantreas/ccna-platform/main/public/images/certificate-bg.png';
        const response = await fetch(templateUrl);
        const blob = await response.blob();
        const reader = new FileReader();
        await new Promise((resolve) => {
          reader.onload = function() { doc.addImage(reader.result, 'PNG', 0, 0, w, h); resolve(); };
          reader.readAsDataURL(blob);
        });
      } catch(e) {
        doc.setFillColor(255, 255, 255);
        doc.rect(0, 0, w, h, 'F');
      }

      doc.setTextColor(100, 116, 139);
      doc.setFontSize(12);
      doc.text('This certificate is proudly awarded to', w / 2, 85, { align: 'center' });

      doc.setTextColor(30, 41, 59);
      doc.setFontSize(40);
      doc.text(userName, w / 2, 105, { align: 'center' });

      doc.setTextColor(100, 116, 139);
      doc.setFontSize(12);
      doc.text('for the successful completion of the', w / 2, 125, { align: 'center' });

      doc.setTextColor(30, 41, 59);
      doc.setFontSize(20);
      doc.text('Network Engineering Program', w / 2, 140, { align: 'center' });

      const date = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
      doc.setTextColor(100, 116, 139);
      doc.setFontSize(11);
      doc.text(`Issued on ${date}`, w / 2, 160, { align: 'center' });

      doc.save(`NetworkLearn-Certificate-${userName.replace(/\s+/g, '-').toLowerCase()}.pdf`);
      alert('Certificate downloaded!');
    });

    // Upgrade button handler
    document.getElementById('upgrade-btn')?.addEventListener('click', async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) {
        window.location.href = '/en/login';
        return;
      }

      // Use stored profile data instead of separate query
      if (currentUserData?.profile?.plan === 'pro') {
        // Show already Pro modal
        document.getElementById('already-pro-modal')?.classList.remove('hidden');
      } else {
        // Go to pricing page
        window.location.href = '/en/pricing';
      }
    });

    // Real-time subscriptions for live updates
    const userId = localStorage.getItem('userId');
    if (userId) {
      // Subscribe to lesson progress changes
      supabase
        .channel('lesson-progress-changes')
        .on('postgres_changes', {
          event: '*',
          schema: 'public',
          table: 'lesson_progress',
          filter: `user_id=eq.${userId}`,
        }, () => {
          // Reload dashboard when progress changes
          loadDashboard();
        })
        .subscribe();

      // Subscribe to quiz score changes
      supabase
        .channel('quiz-score-changes')
        .on('postgres_changes', {
          event: '*',
          schema: 'public',
          table: 'quiz_scores',
          filter: `user_id=eq.${userId}`,
        }, () => {
          loadDashboard();
        })
        .subscribe();

      // Subscribe to points changes
      supabase
        .channel('points-changes')
        .on('postgres_changes', {
          event: '*',
          schema: 'public',
          table: 'user_points',
          filter: `user_id=eq.${userId}`,
        }, () => {
          loadDashboard();
        })
        .subscribe();
    }
  </script>
</BaseLayout>

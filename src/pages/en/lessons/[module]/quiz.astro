---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/layout/Header.tsx';
import Footer from '../../../../components/layout/Footer.tsx';
import QuizEngine from '../../../../components/quiz/QuizEngine.tsx';
import FeedbackForm from '../../../../components/ui/FeedbackForm.tsx';
import en from '../../../../i18n/en.json';
import { allQuizzes } from '../../../../lib/quiz-questions';

const locale = 'en' as const;
const t = en;

const moduleNames: Record<number, string> = {
  1: 'Network Fundamentals', 2: 'Network Access', 3: 'IP Connectivity',
  4: 'IP Services', 5: 'Security Fundamentals', 6: 'Automation & Programmability',
};

export function getStaticPaths() {
  return [
    { params: { module: '1' } }, { params: { module: '2' } }, { params: { module: '3' } },
    { params: { module: '4' } }, { params: { module: '5' } }, { params: { module: '6' } },
  ];
}

const { module: moduleParam } = Astro.params;
const moduleNum = parseInt(moduleParam || '1');
const moduleName = moduleNames[moduleNum] || 'Network Fundamentals';
const questions = allQuizzes[moduleNum] || [];
const quizQuestions = questions.map((q, i) => ({ id: `m${moduleNum}q${i + 1}`, ...q }));
---

<BaseLayout title={`${t.quiz.title} - ${moduleName}`} lang={locale}>
  <Header locale={locale} translations={t} client:load />

  <main class="pt-24 pb-16 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 text-primary text-sm font-medium mb-4">
          🎯 {t.modules.module} {moduleNum}
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold mb-2">{t.quiz.title}: {moduleName}</h1>
        <p class="text-text-muted">{questions.length} questions</p>
      </div>

      {/* Pro Check - show upgrade prompt for free users */}
      <div id="pro-gate" class="hidden">
        <div class="bg-surface-card rounded-2xl border border-primary/10 p-12 text-center max-w-lg mx-auto">
          <div class="text-6xl mb-4">🔒</div>
          <h2 class="text-2xl font-bold text-text mb-2">Pro Feature</h2>
          <p class="text-text-muted mb-6">
            Gamified quizzes with scoring, streaks, and achievements are available for Pro users only.
          </p>
          <div class="flex flex-col gap-3">
            <a href={`/${locale}/pricing`} class="px-6 py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity text-center">
              {t.pricing.upgrade} →
            </a>
            <a href={`/${locale}/curriculum`} class="px-6 py-3 border border-primary/30 text-primary rounded-xl font-medium hover:bg-primary/10 transition-all text-center">
              {t.lesson.back_to_curriculum}
            </a>
          </div>
        </div>
      </div>

      {/* Quiz Engine - shown for Pro users */}
      <div id="quiz-container">
        <QuizEngine
        moduleNumber={moduleNum}
        moduleName={moduleName}
        questions={quizQuestions}
        locale={locale}
        client:load
      />

      {/* Feedback Form - shown after quiz */}
      <div class="mt-12">
        <FeedbackForm
          moduleNumber={moduleNum}
          moduleName={moduleName}
          locale={locale}
          client:load
        />
      </div>
      </div>
    </div>
  </main>

  <Footer locale={locale} translations={t} />

  <script>
    import { supabase } from '../../../../lib/supabase';

    async function checkProAccess() {
      const { data: { session } } = await supabase.auth.getSession();
      const proGate = document.getElementById('pro-gate');
      const quizContainer = document.getElementById('quiz-container');

      if (!session?.user) {
        // Not logged in - show gate
        proGate?.classList.remove('hidden');
        quizContainer?.classList.add('hidden');
        return;
      }

      // Check if user is Pro
      const { data: profile } = await supabase
        .from('profiles')
        .select('plan')
        .eq('id', session.user.id)
        .single();

      if (profile?.plan !== 'pro') {
        proGate?.classList.remove('hidden');
        quizContainer?.classList.add('hidden');
      }
    }
    checkProAccess();
  </script>
</BaseLayout>

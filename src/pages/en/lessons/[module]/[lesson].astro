---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/layout/Header.tsx';
import Footer from '../../../../components/layout/Footer.tsx';
import en from '../../../../i18n/en.json';

const locale = 'en' as const;
const t = en;

// Import lesson content for all modules
import { module1Lessons } from '../../../../lib/lessons/module1';
import { module2Lessons } from '../../../../lib/lessons/module2';
import { module3Lessons } from '../../../../lib/lessons/module3';
import { module4Lessons } from '../../../../lib/lessons/module4';
import { module5Lessons } from '../../../../lib/lessons/module5';
import { module6Lessons } from '../../../../lib/lessons/module6';

const allModuleLessons: Record<number, Record<number, { objectives: string[]; keyTerms: { term: string; definition: string }[]; content: string }>> = {
  1: module1Lessons,
  2: module2Lessons,
  3: module3Lessons,
  4: module4Lessons,
  5: module5Lessons,
  6: module6Lessons,
};

const moduleNames: Record<number, string> = {
  1: 'Network Fundamentals',
  2: 'Network Access',
  3: 'IP Connectivity',
  4: 'IP Services',
  5: 'Security Fundamentals',
  6: 'Automation & Programmability',
};

const moduleLessonTitles: Record<number, string[]> = {
  1: ['OSI & TCP/IP Models', 'Network Topologies & Types', 'Cabling & Physical Infrastructure', 'IPv4 Addressing & Binary Math', 'IPv4 Subnetting & VLSM', 'IPv6 Addressing', 'TCP, UDP, ARP, DNS, ICMP', 'Cisco CLI Basics'],
  2: ['Ethernet & MAC Addresses', 'Switch Operations', 'VLANs & Trunking (802.1Q)', 'EtherChannel', 'Spanning Tree Protocol (STP)', 'Wireless Fundamentals', 'PoE & Wireless Security'],
  3: ['Routing Table & Path Selection', 'Static Routes', 'Inter-VLAN Routing', 'OSPF Single Area', 'OSPF Multi-Area Concepts', 'First Hop Redundancy (HSRP/VRRP)'],
  4: ['DHCP', 'NAT & PAT', 'NTP & Syslog', 'SNMP & QoS', 'SSH & Remote Access'],
  5: ['Security Threats Overview', 'Access Control Lists (ACLs)', 'Port Security & DHCP Snooping', 'AAA & 802.1X', 'VPN Concepts & Firewalls'],
  6: ['SDN Concepts', 'REST APIs & Data Formats', 'Configuration Management', 'Cisco DNA Center & Programmability'],
};

export function getStaticPaths() {
  const paths: { params: { module: string; lesson: string } }[] = [];
  for (let m = 1; m <= 6; m++) {
    const lessonCount = [8, 7, 6, 5, 5, 4][m - 1];
    for (let l = 1; l <= lessonCount; l++) {
      paths.push({ params: { module: String(m), lesson: String(l) } });
    }
  }
  return paths;
}

const { module: moduleParam, lesson: lessonParam } = Astro.params;
const moduleNum = parseInt(moduleParam || '1');
const lessonNum = parseInt(lessonParam || '1');

const moduleName = moduleNames[moduleNum] || 'Network Fundamentals';
const lessonTitle = moduleLessonTitles[moduleNum]?.[lessonNum - 1] || 'Lesson';
const content = allModuleLessons[moduleNum]?.[lessonNum] || null;

const lessonCount = moduleLessonTitles[moduleNum]?.length || 1;
const prevLesson = lessonNum > 1
  ? { module: moduleNum, lesson: lessonNum - 1 }
  : moduleNum > 1
    ? { module: moduleNum - 1, lesson: moduleLessonTitles[moduleNum - 1]?.length || 1 }
    : null;
const nextLesson = lessonNum < lessonCount
  ? { module: moduleNum, lesson: lessonNum + 1 }
  : moduleNum < 6
    ? { module: moduleNum + 1, lesson: 1 }
    : null;

// Simple markdown to HTML converter
function mdToHtml(md: string): string {
  let html = md
    // Images (before other processing)
    .replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<div class="my-8 flex justify-center"><img src="$2" alt="$1" class="rounded-xl border border-primary/10 max-w-full h-auto shadow-lg" loading="lazy" /></div>')
    // Headers
    .replace(/^### (.+)$/gm, '<h3 class="text-xl font-bold text-text mt-8 mb-3">$1</h3>')
    .replace(/^## (.+)$/gm, '<h2 class="text-2xl font-bold text-text mt-10 mb-4 pb-2 border-b border-primary/10">$1</h2>')
    // Bold
    .replace(/\*\*(.+?)\*\*/g, '<strong class="text-text font-semibold">$1</strong>')
    // Inline code
    .replace(/`([^`]+)`/g, '<code class="px-1.5 py-0.5 bg-surface-light rounded text-primary text-sm font-mono">$1</code>')
    // Code blocks
    .replace(/```(\w*)\n([\s\S]*?)```/g, '<pre class="bg-surface-light rounded-xl p-4 overflow-x-auto my-4 border border-primary/10"><code class="text-sm font-mono text-text-muted">$2</code></pre>')
    // Tables (basic)
    .replace(/\|(.+)\|/g, (match) => {
      const cells = match.split('|').filter(c => c.trim());
      if (cells.some(c => c.trim().match(/^[-:]+$/))) return ''; // separator row
      const isHeader = !match.includes('---');
      return '<tr>' + cells.map(c => {
        const cell = c.trim();
        return isHeader
          ? `<th class="px-4 py-2 bg-surface-light text-left text-sm font-semibold text-text border border-primary/10">${cell}</th>`
          : `<td class="px-4 py-2 text-sm text-text-muted border border-primary/10">${cell}</td>`;
      }).join('') + '</tr>';
    })
    // Blockquotes
    .replace(/^> (.+)$/gm, '<blockquote class="pl-4 border-l-4 border-primary/30 text-text-muted italic my-4">$1</blockquote>')
    // Unordered lists
    .replace(/^- (.+)$/gm, '<li class="flex items-start gap-2 text-text-muted"><span class="text-primary mt-1.5">•</span><span>$1</span></li>')
    // Paragraphs (lines not starting with < and not empty)
    .replace(/^(?!<|$|\s*$)(.+)$/gm, '<p class="text-text-muted leading-relaxed mb-4">$1</p>')
    // Clean up empty paragraphs
    .replace(/<p class="[^"]*"><\/p>/g, '')
    // Wrap tables
    .replace(/(<tr>[\s\S]*?<\/tr>\s*)+/g, (match) => `<div class="overflow-x-auto my-4"><table class="w-full border-collapse">${match}</table></div>`);

  return html;
}
---

<BaseLayout title={`${lessonTitle} - Module ${moduleNum}`} lang={locale}>
  <Header locale={locale} translations={t} client:load />

  <main class="pt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex gap-8">
      {/* Sidebar */}
      <aside class="hidden lg:block w-64 flex-shrink-0">
        <div class="sticky top-24 space-y-4">
          <div class="bg-surface-card rounded-xl border border-primary/10 p-4">
            <h3 class="text-sm font-bold text-primary mb-3">
              {t.modules.module} {moduleNum}: {moduleName}
            </h3>
            <ul class="space-y-1" id="lesson-sidebar">
              {(moduleLessonTitles[moduleNum] || []).map((lesson, idx) => (
                <li>
                  <a
                    href={`/${locale}/lessons/${moduleNum}/${idx + 1}`}
                    class={`flex items-center gap-2 px-3 py-2 rounded-lg text-sm transition-colors ${
                      idx + 1 === lessonNum
                        ? 'bg-primary/10 text-primary font-medium'
                        : 'text-text-muted hover:text-primary hover:bg-surface-light'
                    }`}
                  >
                    <span id={`lesson-badge-${idx + 1}`} class={`w-6 h-6 rounded flex items-center justify-center text-xs ${
                      idx + 1 === lessonNum ? 'bg-primary/20 text-primary' : 'bg-surface text-text-muted'
                    }`}>
                      {idx + 1}
                    </span>
                    <span class="truncate">{lesson}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <a
            href={`/${locale}/lessons/${moduleNum}/quiz`}
            class="block bg-gradient-to-r from-primary/10 to-accent/10 rounded-xl border border-primary/20 p-4 hover:border-primary/40 transition-colors"
          >
            <div class="text-sm font-bold text-primary mb-1">🎯 {t.quiz.title}</div>
            <div class="text-xs text-text-muted">Test your knowledge</div>
          </a>
        </div>
      </aside>

      {/* Main content */}
      <article class="flex-grow max-w-4xl pb-16">
        {/* Breadcrumb */}
        <nav class="flex items-center gap-2 text-sm text-text-muted mb-8">
          <a href={`/${locale}/curriculum`} class="hover:text-primary">{t.nav.curriculum}</a>
          <span>/</span>
          <a href={`/${locale}/curriculum`} class="hover:text-primary">{t.modules.module} {moduleNum}</a>
          <span>/</span>
          <span class="text-primary">{lessonTitle}</span>
        </nav>

        {/* Lesson header */}
        <div class="mb-8">
          <div class="flex items-center gap-3 mb-2">
            <span class="px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-medium">
              {t.modules.module} {moduleNum}
            </span>
            <span class="px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-medium">
              Lesson {lessonNum} of {lessonCount}
            </span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold text-text">
            {lessonTitle}
          </h1>
        </div>

        {content ? (
          <>
            {/* Learning Objectives */}
            <div class="bg-primary/5 rounded-xl border border-primary/10 p-6 mb-8">
              <h2 class="text-lg font-bold text-primary mb-4 flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {t.lesson.objectives}
              </h2>
              <ul class="space-y-2">
                {content.objectives.map((obj) => (
                  <li class="flex items-start gap-2 text-text-muted">
                    <span class="text-primary mt-1">•</span>
                    {obj}
                  </li>
                ))}
              </ul>
            </div>

            {/* Lesson content */}
            <div class="prose max-w-none" set:html={mdToHtml(content.content)} />

            {/* Key Terms */}
            <div class="mt-12 bg-surface-card rounded-xl border border-primary/10 p-6">
              <h2 class="text-lg font-bold text-text mb-4 flex items-center gap-2">
                📖 {t.lesson.key_terms}
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {content.keyTerms.map((kt) => (
                  <div class="p-4 bg-surface-light rounded-lg">
                    <div class="font-bold text-primary text-sm mb-1">{kt.term}</div>
                    <div class="text-text-muted text-sm">{kt.definition}</div>
                  </div>
                ))}
              </div>
            </div>

            {/* Test Your Knowledge */}
            <div class="mt-12 bg-gradient-to-r from-primary/5 to-accent/5 rounded-xl border border-primary/10 p-6">
              <h2 class="text-lg font-bold text-text mb-4 flex items-center gap-2">
                🧠 {t.lesson.test_knowledge}
              </h2>
              <p class="text-text-muted mb-4">
                Ready to test what you've learned? Take the module quiz to earn points and track your progress.
              </p>
              <a
                href={`/${locale}/lessons/${moduleNum}/quiz`}
                class="inline-flex px-6 py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity"
              >
                Start Module {moduleNum} Quiz →
              </a>
            </div>
          </>
        ) : (
          <div class="bg-surface-card rounded-xl border border-primary/10 p-12 text-center">
            <div class="text-6xl mb-4">📚</div>
            <h2 class="text-2xl font-bold text-text mb-2">{lessonTitle}</h2>
            <p class="text-text-muted mb-6">
              Content for this lesson is being prepared. Check back soon.
            </p>
            <a href={`/${locale}/curriculum`} class="inline-flex px-6 py-3 bg-primary/10 text-primary rounded-xl font-medium hover:bg-primary/20 transition-colors">
              {t.lesson.back_to_curriculum}
            </a>
          </div>
        )}

        {/* Navigation */}
        <div class="mt-8 flex items-center justify-between">
          {prevLesson ? (
            <a
              href={`/${locale}/lessons/${prevLesson.module}/${prevLesson.lesson}`}
              class="flex items-center gap-2 px-4 py-2 text-text-muted hover:text-primary transition-colors"
            >
              ← {t.lesson.prev_lesson}
            </a>
          ) : <div />}
          {nextLesson ? (
            <button
              id="next-lesson-btn"
              data-href={`/${locale}/lessons/${nextLesson.module}/${nextLesson.lesson}`}
              class="flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity cursor-pointer"
            >
              {t.lesson.next_lesson} →
            </button>
          ) : <div />}
        </div>

        {/* Completion Modal */}
        <div id="completion-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm">
          <div class="bg-surface-card rounded-2xl border border-primary/10 p-8 max-w-md mx-4 text-center animate-fade-in">
            <div class="text-5xl mb-4">📚</div>
            <h2 class="text-2xl font-bold text-text mb-2">Lesson Complete?</h2>
            <p class="text-text-muted mb-6">Have you finished studying this lesson?</p>
            <div class="flex gap-3 justify-center">
              <button
                id="modal-yes"
                class="px-6 py-3 bg-gradient-to-r from-success to-emerald-500 text-white rounded-xl font-medium hover:opacity-90 transition-opacity"
              >
                ✓ Yes, I'm done
              </button>
              <button
                id="modal-no"
                class="px-6 py-3 border border-primary/30 text-primary rounded-xl font-medium hover:bg-primary/10 transition-all"
              >
                Not yet
              </button>
            </div>
          </div>
        </div>

        {/* Already Completed Badge */}
        <div id="completed-badge" class="hidden mt-6 flex justify-center">
          <div class="flex items-center gap-2 px-4 py-2 bg-success/10 text-success rounded-full text-sm font-medium">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M5 13l4 4L19 7" />
            </svg>
            Lesson Completed
          </div>
        </div>
      </article>
    </div>
  </main>

  <Footer locale={locale} translations={t} />

  <script>
    import { createClient } from '@supabase/supabase-js';

    const supabase = createClient(
      'https://jhesstimsojwmkdysmpy.supabase.co',
      'sb_publishable_bKD9biIulcfC5iNipD-8IA_3Zu4bmWD'
    );

    const moduleNum = parseInt(window.location.pathname.split('/')[3] || '1');
    const lessonNum = parseInt(window.location.pathname.split('/')[4] || '1');

    // Track time spent
    let startTime = Date.now();
    let saved = false;

    // Save lesson progress
    async function saveLessonProgress(status: 'in_progress' | 'completed') {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session?.user) return;

        const timeSpent = Math.floor((Date.now() - startTime) / 1000);

        await supabase.from('lesson_progress').upsert({
          user_id: session.user.id,
          module_number: moduleNum,
          lesson_number: lessonNum,
          status: status,
          time_spent_seconds: timeSpent,
          completed_at: status === 'completed' ? new Date().toISOString() : null,
        }, { onConflict: 'user_id,module_number,lesson_number' });

        saved = true;
      } catch (error) {
        console.error('Error saving lesson progress:', error);
      }
    }

    // Update sidebar badges for completed lessons
    async function updateSidebarBadges() {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) return;

      const { data: progress } = await supabase
        .from('lesson_progress')
        .select('lesson_number, status')
        .eq('user_id', session.user.id)
        .eq('module_number', moduleNum);

      if (progress) {
        progress.forEach(p => {
          if (p.status === 'completed') {
            const badge = document.getElementById(`lesson-badge-${p.lesson_number}`);
            if (badge) {
              badge.textContent = '✓';
              badge.className = 'w-6 h-6 rounded flex items-center justify-center text-xs bg-success/20 text-success font-bold';
            }
          }
        });
      }
    }
    updateSidebarBadges();

    // Check if already completed
    async function checkCompletion() {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) return;

      const { data } = await supabase
        .from('lesson_progress')
        .select('status')
        .eq('user_id', session.user.id)
        .eq('module_number', moduleNum)
        .eq('lesson_number', lessonNum)
        .single();

      if (data?.status === 'completed') {
        saved = true;
        document.getElementById('completed-badge')?.classList.remove('hidden');
      }
    }
    checkCompletion();

    // Mark as in_progress when page loads
    saveLessonProgress('in_progress');

    // Next Lesson button - shows completion modal if not yet completed
    const nextBtn = document.getElementById('next-lesson-btn');
    const modal = document.getElementById('completion-modal');
    const modalYes = document.getElementById('modal-yes');
    const modalNo = document.getElementById('modal-no');

    nextBtn?.addEventListener('click', () => {
      if (saved) {
        // Already completed, go directly
        window.location.href = nextBtn.getAttribute('data-href') || '';
      } else {
        // Show modal
        modal?.classList.remove('hidden');
      }
    });

    // Modal: Yes, I'm done
    modalYes?.addEventListener('click', async () => {
      await saveLessonProgress('completed');
      // Update sidebar badge
      const badge = document.getElementById(`lesson-badge-${lessonNum}`);
      if (badge) {
        badge.textContent = '✓';
        badge.className = 'w-6 h-6 rounded flex items-center justify-center text-xs bg-success/20 text-success font-bold';
      }
      modal?.classList.add('hidden');
      document.getElementById('completed-badge')?.classList.remove('hidden');
      // Navigate to next lesson
      const href = nextBtn?.getAttribute('data-href');
      if (href) window.location.href = href;
    });

    // Modal: Not yet
    modalNo?.addEventListener('click', () => {
      modal?.classList.add('hidden');
      // Navigate without marking complete
      const href = nextBtn?.getAttribute('data-href');
      if (href) window.location.href = href;
    });

    // Close modal on outside click
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.classList.add('hidden');
    });

    // Save on page unload
    window.addEventListener('beforeunload', () => {
      if (!saved) saveLessonProgress('in_progress');
    });
  </script>
</BaseLayout>

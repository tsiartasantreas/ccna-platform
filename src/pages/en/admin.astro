---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.tsx';
import Footer from '../../components/layout/Footer.tsx';
import en from '../../i18n/en.json';

const locale = 'en' as const;
const t = en;
---

<BaseLayout title="Admin Dashboard" lang={locale}>
  <Header locale={locale} translations={t} client:load />

  {/* Access Denied Screen - shown by default, hidden by JS if admin */}
  <div id="access-denied" class="min-h-screen flex items-center justify-center pt-16">
    <div class="text-center max-w-md mx-auto px-4">
      <div class="text-6xl mb-6">🔒</div>
      <h1 class="text-3xl font-bold text-text mb-4">Access Denied</h1>
      <p class="text-text-muted mb-6">You must be logged in with the admin account to access this page.</p>
      <a href={`/${locale}/login`} class="inline-flex px-6 py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity">
        Login as Admin →
      </a>
    </div>
  </div>

  {/* Admin Content - hidden by default, shown by JS if admin */}
  <div id="admin-content" class="hidden">
  <main class="pt-24 pb-16 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Admin Header */}
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl font-bold text-text">🔧 Admin Dashboard</h1>
          <p class="text-text-muted">Manage your NetworkLearn platform</p>
        </div>
        <div class="flex items-center gap-3">
          <span class="px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-medium">Admin</span>
          <span class="text-sm text-text-muted" id="admin-email">tsiartasantreas@gmail.com</span>
        </div>
      </div>

      {/* Tab Navigation */}
      <div class="flex gap-1 mb-8 bg-surface-card rounded-xl p-1 border border-primary/10 overflow-x-auto">
        <button class="tab-btn active px-4 py-2 rounded-lg text-sm font-medium transition-all" data-tab="stats">📊 Statistics</button>
        <button class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all" data-tab="users">👥 Users</button>
        <button class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all" data-tab="subscriptions">💳 Subscriptions</button>
        <button class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all" data-tab="revolut">💰 Revolut</button>
        <button class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all" data-tab="supabase">🗄️ Supabase</button>
        <button class="tab-btn px-4 py-2 rounded-lg text-sm font-medium transition-all" data-tab="settings">⚙️ Settings</button>
      </div>

      {/* Statistics Tab */}
      <div id="tab-stats" class="tab-content">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="text-sm text-text-muted mb-1">Total Users</div>
            <div class="text-3xl font-bold text-primary" id="stat-total-users">0</div>
          </div>
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="text-sm text-text-muted mb-1">Pro Users</div>
            <div class="text-3xl font-bold text-accent" id="stat-pro-users">0</div>
          </div>
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="text-sm text-text-muted mb-1">Revenue (Month)</div>
            <div class="text-3xl font-bold text-warning" id="stat-revenue">€0.00</div>
          </div>
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="text-sm text-text-muted mb-1">Free Users</div>
            <div class="text-3xl font-bold text-text" id="stat-free-users">0</div>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="text-sm text-text-muted mb-1">New This Week</div>
            <div class="text-2xl font-bold text-text" id="stat-new-week">0</div>
          </div>
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="text-sm text-text-muted mb-1">Avg Quiz Score</div>
            <div class="text-2xl font-bold text-text" id="stat-avg-score">0%</div>
          </div>
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="text-sm text-text-muted mb-1">Lessons Completed</div>
            <div class="text-2xl font-bold text-text" id="stat-lessons-completed">0</div>
          </div>
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="text-sm text-text-muted mb-1">Quizzes Taken</div>
            <div class="text-2xl font-bold text-text" id="stat-quizzes-taken">0</div>
          </div>
        </div>

        {/* User Growth Chart */}
        <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
          <h3 class="text-lg font-bold text-text mb-4">User Growth (Last 30 Days)</h3>
          <div class="h-48 flex items-end gap-1" id="growth-chart">
            <div class="flex-1 bg-surface-light rounded-t" style="height: 10%"></div>
          </div>
          <div class="flex justify-between text-xs text-text-muted mt-2">
            <span>30 days ago</span>
            <span>Today</span>
          </div>
        </div>
      </div>

      {/* Users Tab */}
      <div id="tab-users" class="tab-content hidden">
        <div class="bg-surface-card rounded-xl border border-primary/10 overflow-hidden">
          <div class="p-4 border-b border-primary/10 flex items-center justify-between">
            <h3 class="text-lg font-bold text-text">Registered Users</h3>
            <div class="flex gap-2">
              <input type="text" placeholder="Search users..." class="px-3 py-1.5 bg-surface border border-primary/10 rounded-lg text-sm text-text" id="user-search" />
              <button class="px-3 py-1.5 bg-primary/10 text-primary rounded-lg text-sm font-medium">Export CSV</button>
            </div>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-primary/10">
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">User</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Email</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Plan</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Lessons</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Avg Score</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Last Active</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Actions</th>
                </tr>
              </thead>
              <tbody id="users-table-body">
                <tr class="border-b border-primary/5 hover:bg-surface-light">
                  <td class="px-4 py-3 text-sm text-text font-medium">Andreas Tsiartas</td>
                  <td class="px-4 py-3 text-sm text-text-muted">tsiartasantreas@gmail.com</td>
                  <td class="px-4 py-3"><span class="px-2 py-0.5 rounded-full bg-accent/10 text-accent text-xs font-medium">Pro</span></td>
                  <td class="px-4 py-3 text-sm text-text">35/35</td>
                  <td class="px-4 py-3 text-sm text-success">95%</td>
                  <td class="px-4 py-3 text-sm text-text-muted">Today</td>
                  <td class="px-4 py-3"><button class="text-xs text-primary hover:underline">Reset Password</button></td>
                </tr>
                <tr class="border-b border-primary/5 hover:bg-surface-light">
                  <td class="px-4 py-3 text-sm text-text font-medium">John Smith</td>
                  <td class="px-4 py-3 text-sm text-text-muted">john@example.com</td>
                  <td class="px-4 py-3"><span class="px-2 py-0.5 rounded-full bg-accent/10 text-accent text-xs font-medium">Pro</span></td>
                  <td class="px-4 py-3 text-sm text-text">12/35</td>
                  <td class="px-4 py-3 text-sm text-success">82%</td>
                  <td class="px-4 py-3 text-sm text-text-muted">Today</td>
                  <td class="px-4 py-3"><button class="text-xs text-primary hover:underline">Reset Password</button></td>
                </tr>
                <tr class="border-b border-primary/5 hover:bg-surface-light">
                  <td class="px-4 py-3 text-sm text-text font-medium">Maria Papadaki</td>
                  <td class="px-4 py-3 text-sm text-text-muted">maria@example.com</td>
                  <td class="px-4 py-3"><span class="px-2 py-0.5 rounded-full bg-surface-light text-text-muted text-xs font-medium">Free</span></td>
                  <td class="px-4 py-3 text-sm text-text">8/35</td>
                  <td class="px-4 py-3 text-sm text-text-muted">—</td>
                  <td class="px-4 py-3 text-sm text-text-muted">Yesterday</td>
                  <td class="px-4 py-3"><button class="text-xs text-primary hover:underline">Reset Password</button></td>
                </tr>
                <tr class="border-b border-primary/5 hover:bg-surface-light">
                  <td class="px-4 py-3 text-sm text-text font-medium">Giorgos Nikolaou</td>
                  <td class="px-4 py-3 text-sm text-text-muted">giorgos@example.com</td>
                  <td class="px-4 py-3"><span class="px-2 py-0.5 rounded-full bg-surface-light text-text-muted text-xs font-medium">Free</span></td>
                  <td class="px-4 py-3 text-sm text-text">5/35</td>
                  <td class="px-4 py-3 text-sm text-warning">70%</td>
                  <td class="px-4 py-3 text-sm text-text-muted">Today</td>
                  <td class="px-4 py-3"><button class="text-xs text-primary hover:underline">Reset Password</button></td>
                </tr>
                <tr class="border-b border-primary/5 hover:bg-surface-light">
                  <td class="px-4 py-3 text-sm text-text font-medium">Sarah Johnson</td>
                  <td class="px-4 py-3 text-sm text-text-muted">sarah@example.com</td>
                  <td class="px-4 py-3"><span class="px-2 py-0.5 rounded-full bg-accent/10 text-accent text-xs font-medium">Pro</span></td>
                  <td class="px-4 py-3 text-sm text-text">20/35</td>
                  <td class="px-4 py-3 text-sm text-success">88%</td>
                  <td class="px-4 py-3 text-sm text-text-muted">Today</td>
                  <td class="px-4 py-3"><button class="text-xs text-primary hover:underline">Reset Password</button></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      {/* Subscriptions Tab */}
      <div id="tab-subscriptions" class="tab-content hidden">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-8">
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="text-sm text-text-muted mb-1">Active Subscriptions</div>
            <div class="text-3xl font-bold text-success" id="active-subs-count">0</div>
          </div>
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="text-sm text-text-muted mb-1">Monthly Revenue</div>
            <div class="text-3xl font-bold text-primary" id="monthly-revenue">€0.00</div>
          </div>
        </div>

        <div class="bg-surface-card rounded-xl border border-primary/10 overflow-hidden">
          <div class="p-4 border-b border-primary/10">
            <h3 class="text-lg font-bold text-text">Pro Subscriptions</h3>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-primary/10">
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">User</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">ID</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Plan</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Status</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Amount</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Since</th>
                  <th class="px-4 py-3 text-left text-sm font-medium text-text-muted">Actions</th>
                </tr>
              </thead>
              <tbody id="subscriptions-table-body">
                <tr><td colspan="7" class="px-4 py-8 text-center text-text-muted">Loading...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      {/* Revolut Tab */}
      <div id="tab-revolut" class="tab-content hidden">
        <div class="bg-surface-card rounded-xl border border-primary/10 p-6 mb-6">
          <h3 class="text-lg font-bold text-text mb-4">💰 Revolut Business API Configuration</h3>
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-text mb-1">API Key</label>
              <input type="password" id="revolut-api-key" placeholder="sk_live_..." class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text font-mono text-sm" />
            </div>
            <div>
              <label class="block text-sm font-medium text-text mb-1">Webhook Secret</label>
              <input type="password" id="revolut-webhook-secret" placeholder="whsec_..." class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text font-mono text-sm" />
            </div>
            <div>
              <label class="block text-sm font-medium text-text mb-1">Merchant ID</label>
              <input type="text" id="revolut-merchant-id" placeholder="merchant_..." class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text font-mono text-sm" />
            </div>
            <button id="save-revolut" class="px-6 py-2 bg-gradient-to-r from-primary to-accent text-white rounded-lg font-medium hover:opacity-90 transition-opacity">
              Save Revolut Settings
            </button>
          </div>
        </div>

        <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
          <h3 class="text-lg font-bold text-text mb-4">Webhook Configuration</h3>
          <p class="text-text-muted text-sm mb-4">Configure this webhook URL in your Revolut Business dashboard:</p>
          <div class="flex items-center gap-2">
            <code class="flex-1 px-4 py-2 bg-surface rounded-lg text-primary text-sm font-mono">https://ccna-platform.wasmer.app/api/revolut/webhook</code>
            <button class="px-3 py-2 bg-primary/10 text-primary rounded-lg text-sm font-medium" onclick="navigator.clipboard.writeText('https://ccna-platform.wasmer.app/api/revolut/webhook')">Copy</button>
          </div>
        </div>
      </div>

      {/* Supabase Tab */}
      <div id="tab-supabase" class="tab-content hidden">
        <div class="bg-surface-card rounded-xl border border-primary/10 p-6 mb-6">
          <h3 class="text-lg font-bold text-text mb-4">🗄️ Supabase Configuration</h3>
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-text mb-1">Project URL</label>
              <input type="text" id="supabase-url" value="https://jhesstimsojwmkdysmpy.supabase.co" class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text font-mono text-sm" />
            </div>
            <div>
              <label class="block text-sm font-medium text-text mb-1">Anon Key (Public)</label>
              <input type="password" id="supabase-anon-key" placeholder="eyJhbGciOiJIUzI1NiIs..." class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text font-mono text-sm" />
            </div>
            <div>
              <label class="block text-sm font-medium text-text mb-1">Service Role Key (Secret)</label>
              <input type="password" id="supabase-service-key" placeholder="eyJhbGciOiJIUzI1NiIs..." class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text font-mono text-sm" />
            </div>
            <button id="save-supabase" class="px-6 py-2 bg-gradient-to-r from-primary to-accent text-white rounded-lg font-medium hover:opacity-90 transition-opacity">
              Save Supabase Settings
            </button>
          </div>
        </div>

        <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
          <h3 class="text-lg font-bold text-text mb-4">Database Status</h3>
          <div class="grid grid-cols-2 gap-4">
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 rounded-full bg-success"></div>
              <span class="text-sm text-text">profiles table</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 rounded-full bg-success"></div>
              <span class="text-sm text-text">lesson_progress table</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 rounded-full bg-success"></div>
              <span class="text-sm text-text">quiz_scores table</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 rounded-full bg-success"></div>
              <span class="text-sm text-text">user_points table</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 rounded-full bg-success"></div>
              <span class="text-sm text-text">RLS policies</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-3 h-3 rounded-full bg-success"></div>
              <span class="text-sm text-text">Triggers</span>
            </div>
          </div>
        </div>
      </div>

      {/* Settings Tab */}
      <div id="tab-settings" class="tab-content hidden">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {/* General Settings */}
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <h3 class="text-lg font-bold text-text mb-4">⚙️ General Settings</h3>
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-text mb-1">Site Name</label>
                <input type="text" id="site-name" value="NetworkLearn" class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text" />
                <p class="text-xs text-text-muted mt-1">Displayed in the header and page titles</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-text mb-1">Logo URL</label>
                <input type="text" id="logo-url" placeholder="https://example.com/logo.png" class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text" />
                <p class="text-xs text-text-muted mt-1">Enter a URL for your logo image (PNG/SVG recommended)</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-text mb-1">Logo Preview</label>
                <div class="flex items-center gap-3 p-3 bg-surface rounded-lg border border-primary/10">
                  <div id="logo-preview" class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-accent flex items-center justify-center text-white font-bold text-xl">N</div>
                  <span id="logo-name-preview" class="text-text font-medium">NetworkLearn</span>
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium text-text mb-1">Site URL</label>
                <input type="text" id="site-url" value="https://networklearn.wasmer.app" class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text" />
              </div>
              <button id="save-general" class="w-full px-6 py-2 bg-gradient-to-r from-primary to-accent text-white rounded-lg font-medium hover:opacity-90 transition-opacity">Save General Settings</button>
            </div>
          </div>

          {/* Feature Flags */}
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <h3 class="text-lg font-bold text-text mb-4">🚩 Feature Flags</h3>
            <div class="space-y-4">
              <label class="flex items-center justify-between">
                <span class="text-sm text-text">Enable Registration</span>
                <input type="checkbox" checked class="w-5 h-5 rounded" id="flag-registration" />
              </label>
              <label class="flex items-center justify-between">
                <span class="text-sm text-text">Enable Password Reset</span>
                <input type="checkbox" checked class="w-5 h-5 rounded" id="flag-password-reset" />
              </label>
              <label class="flex items-center justify-between">
                <span class="text-sm text-text">Enable Google OAuth</span>
                <input type="checkbox" class="w-5 h-5 rounded" id="flag-google-oauth" />
              </label>
              <label class="flex items-center justify-between">
                <span class="text-sm text-text">Maintenance Mode</span>
                <input type="checkbox" class="w-5 h-5 rounded" id="flag-maintenance" />
              </label>
            </div>
          </div>

          {/* Email Settings */}
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <h3 class="text-lg font-bold text-text mb-4">📧 Email Settings (SMTP)</h3>
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-text mb-1">SMTP Host</label>
                <input type="text" id="smtp-host" placeholder="smtp.gmail.com" class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text text-sm" />
              </div>
              <div>
                <label class="block text-sm font-medium text-text mb-1">SMTP Port</label>
                <input type="text" id="smtp-port" value="587" class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text text-sm" />
              </div>
              <div>
                <label class="block text-sm font-medium text-text mb-1">SMTP Username</label>
                <input type="text" id="smtp-user" placeholder="your@email.com" class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text text-sm" />
              </div>
              <div>
                <label class="block text-sm font-medium text-text mb-1">SMTP Password</label>
                <input type="password" id="smtp-pass" class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text text-sm" />
              </div>
              <button id="save-email" class="px-6 py-2 bg-primary/10 text-primary rounded-lg font-medium">Save Email Settings</button>
            </div>
          </div>

          {/* Payment Settings */}
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <h3 class="text-lg font-bold text-text mb-4">💳 Payment Settings (Stripe Backup)</h3>
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-text mb-1">Stripe Public Key</label>
                <input type="text" id="stripe-public" placeholder="pk_live_..." class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text font-mono text-sm" />
              </div>
              <div>
                <label class="block text-sm font-medium text-text mb-1">Stripe Secret Key</label>
                <input type="password" id="stripe-secret" placeholder="sk_live_..." class="w-full px-4 py-2 bg-surface border border-primary/10 rounded-lg text-text font-mono text-sm" />
              </div>
              <button id="save-stripe" class="px-6 py-2 bg-primary/10 text-primary rounded-lg font-medium">Save Stripe Settings</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer locale={locale} translations={t} />
  </div>

  <script>
    import { createClient } from '@supabase/supabase-js';

    const supabase = createClient(
      'https://jhesstimsojwmkdysmpy.supabase.co',
      'sb_publishable_bKD9biIulcfC5iNipD-8IA_3Zu4bmWD'
    );
    const ADMIN_EMAIL = 'tsiartasantreas@gmail.com';

    const { data: { session } } = await supabase.auth.getSession();
    const accessDenied = document.getElementById('access-denied');
    const adminContent = document.getElementById('admin-content');

    if (!session?.user || session.user.email !== ADMIN_EMAIL) {
      if (accessDenied) accessDenied.classList.remove('hidden');
      if (adminContent) adminContent.classList.add('hidden');
    } else {
      if (accessDenied) accessDenied.classList.add('hidden');
      if (adminContent) adminContent.classList.remove('hidden');

      // Set admin as pro user if not already
      await supabase.from('profiles').update({ plan: 'pro' }).eq('id', session.user.id);

      async function loadAdminData() {
        const { data: profiles } = await supabase.from('profiles').select('*');
        const { data: allProgress } = await supabase.from('lesson_progress').select('*');
        const { data: allScores } = await supabase.from('quiz_scores').select('*');

        const totalUsers = profiles?.length || 0;
        const proUsers = profiles?.filter(p => p.plan === 'pro').length || 0;
        const revenue = proUsers * 0.99;

        // Calculate real statistics
        const now = new Date();
        const weekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
        const newThisWeek = profiles?.filter(p => new Date(p.created_at) >= weekAgo).length || 0;

        const totalLessonsCompleted = allProgress?.filter(p => p.status === 'completed').length || 0;
        const totalQuizzesTaken = allScores?.length || 0;
        const avgScore = allScores?.length
          ? Math.round(allScores.reduce((sum, s) => sum + Number(s.score), 0) / allScores.length)
          : 0;

        // Update stats
        const freeUsers = totalUsers - proUsers;
        document.getElementById('stat-total-users')!.textContent = String(totalUsers);
        document.getElementById('stat-pro-users')!.textContent = String(proUsers);
        document.getElementById('stat-free-users')!.textContent = String(freeUsers);
        document.getElementById('stat-revenue')!.textContent = `€${revenue.toFixed(2)}`;
        document.getElementById('stat-new-week')!.textContent = String(newThisWeek);
        document.getElementById('stat-avg-score')!.textContent = `${avgScore}%`;
        document.getElementById('stat-lessons-completed')!.textContent = totalLessonsCompleted.toLocaleString();
        document.getElementById('stat-quizzes-taken')!.textContent = totalQuizzesTaken.toLocaleString();

        // Build user growth chart (last 30 days)
        const chartContainer = document.getElementById('growth-chart');
        if (chartContainer && profiles) {
          const days: number[] = [];
          for (let i = 29; i >= 0; i--) {
            const dayStart = new Date(now.getTime() - i * 24 * 60 * 60 * 1000);
            dayStart.setHours(0, 0, 0, 0);
            const dayEnd = new Date(dayStart.getTime() + 24 * 60 * 60 * 1000);
            const count = profiles.filter(p => {
              const created = new Date(p.created_at);
              return created >= dayStart && created < dayEnd;
            }).length;
            days.push(count);
          }
          const maxVal = Math.max(...days, 1);
          chartContainer.innerHTML = days.map((val, i) =>
            `<div class="flex-1 bg-gradient-to-t from-primary to-accent rounded-t transition-all" style="height: ${Math.max((val / maxVal) * 100, 5)}%" title="Day ${i + 1}: ${val} users"></div>`
          ).join('');
        }

        // Update users table with full management
        const tableBody = document.getElementById('users-table-body');
        if (tableBody && profiles) {
          tableBody.innerHTML = profiles.map(p => {
            const userProgress = allProgress?.filter(lp => lp.user_id === p.id) || [];
            const userScores = allScores?.filter(qs => qs.user_id === p.id) || [];
            const lessonsCompleted = userProgress.filter(lp => lp.status === 'completed').length;
            const avgScore = userScores.length ? Math.round(userScores.reduce((s, q) => s + Number(q.score), 0) / userScores.length) : 0;

            return `<tr class="border-b border-primary/5 hover:bg-surface-light" data-user-id="${p.id}">
              <td class="px-4 py-3 text-sm text-text font-medium">${p.display_name || 'User'}</td>
              <td class="px-4 py-3 text-sm text-text-muted font-mono text-xs">${p.email || p.id.substring(0, 8) + '...'}</td>
              <td class="px-4 py-3">
                <select class="plan-select px-2 py-1 bg-surface border border-primary/10 rounded text-xs text-text" data-user-id="${p.id}">
                  <option value="free" ${p.plan === 'free' ? 'selected' : ''}>Free</option>
                  <option value="pro" ${p.plan === 'pro' ? 'selected' : ''}>Pro</option>
                </select>
              </td>
              <td class="px-4 py-3 text-sm text-text">${lessonsCompleted}/35</td>
              <td class="px-4 py-3 text-sm ${avgScore >= 80 ? 'text-success' : avgScore > 0 ? 'text-warning' : 'text-text-muted'}">${avgScore > 0 ? avgScore + '%' : '—'}</td>
              <td class="px-4 py-3 text-sm text-text-muted">${new Date(p.updated_at).toLocaleDateString()}</td>
              <td class="px-4 py-3 flex gap-2 flex-wrap">
                <button class="save-plan-btn text-xs text-success hover:underline" data-user-id="${p.id}">Save</button>
                <button class="reset-pw-btn text-xs text-primary hover:underline" data-user-id="${p.id}">Reset PW</button>
                <button class="cert-btn text-xs text-accent hover:underline" data-user-id="${p.id}" data-user-name="${p.display_name || 'User'}" data-user-email="${p.id}" data-lessons="${lessonsCompleted}" data-score="${avgScore}">🎓 Cert</button>
              </td>
            </tr>`;
          }).join('');

          // Plan change handlers
          document.querySelectorAll('.save-plan-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
              const userId = btn.getAttribute('data-user-id');
              const select = document.querySelector(`.plan-select[data-user-id="${userId}"]`) as HTMLSelectElement;
              if (userId && select) {
                const { error } = await supabase.from('profiles').update({ plan: select.value }).eq('id', userId);
                if (error) {
                  alert('Error: ' + error.message);
                } else {
                  alert('Plan updated to ' + select.value + '!');
                  loadAdminData();
                }
              }
            });
          });

          // Password reset handlers
          document.querySelectorAll('.reset-pw-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
              const userId = btn.getAttribute('data-user-id');
              const user = profiles?.find(p => p.id === userId);
              if (user && confirm(`Send password reset to ${user.id}?`)) {
                alert('Password reset email sent!');
              }
            });
          });

          // Certificate generation handlers
          document.querySelectorAll('.cert-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
              const userId = btn.getAttribute('data-user-id');
              const userName = btn.getAttribute('data-user-name') || 'User';
              const lessons = btn.getAttribute('data-lessons') || '0';
              const score = btn.getAttribute('data-score') || '0';

              if (!confirm(`Generate certificate for ${userName}?`)) return;

              // Import jsPDF dynamically
              const { jsPDF } = await import('jspdf');

              const doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
              const w = doc.internal.pageSize.getWidth();
              const h = doc.internal.pageSize.getHeight();

              // Load certificate template background
              try {
                const templateUrl = 'https://raw.githubusercontent.com/tsiartasantreas/ccna-platform/main/public/images/certificate-bg.png';
                const response = await fetch(templateUrl);
                const blob = await response.blob();
                const reader = new FileReader();
                await new Promise((resolve) => {
                  reader.onload = function() {
                    doc.addImage(reader.result, 'PNG', 0, 0, w, h);
                    resolve();
                  };
                  reader.readAsDataURL(blob);
                });
              } catch(e) {
                doc.setFillColor(255, 255, 255);
                doc.rect(0, 0, w, h, 'F');
              }

              // Only add dynamic text - everything else is in the template

              // "This certificate is proudly awarded to"
              doc.setTextColor(100, 116, 139);
              doc.setFontSize(12);
              doc.text('This certificate is proudly awarded to', w / 2, 85, { align: 'center' });

              // Recipient name (large)
              doc.setTextColor(30, 41, 59);
              doc.setFontSize(40);
              doc.text(userName, w / 2, 105, { align: 'center' });

              // "for the successful completion of the"
              doc.setTextColor(100, 116, 139);
              doc.setFontSize(12);
              doc.text('for the successful completion of the', w / 2, 125, { align: 'center' });

              // "CCNA Training Program"
              doc.setTextColor(30, 41, 59);
              doc.setFontSize(20);
              doc.text('CCNA Training Program', w / 2, 140, { align: 'center' });

              // Date
              const date = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
              doc.setTextColor(100, 116, 139);
              doc.setFontSize(11);
              doc.text(`Issued on ${date}`, w / 2, 160, { align: 'center' });

              // Website footer
              doc.setTextColor(148, 163, 184);
              doc.setFontSize(8);
              doc.text('networklearn.wasmer.app', w / 2, h - 15, { align: 'center' });

              doc.save(`NetworkLearn-Certificate-${userName.replace(/\s+/g, '-').toLowerCase()}.pdf`);
              alert(`Certificate downloaded for ${userName}!`);
            });
          });
        }

        // Update subscriptions table
        const subsBody = document.getElementById('subscriptions-table-body');
        if (subsBody && profiles) {
          const proProfiles = profiles.filter(p => p.plan === 'pro');
          const monthlyUsers = proProfiles.length;
          const revenue = monthlyUsers * 0.99;

          document.getElementById('active-subs-count')!.textContent = String(monthlyUsers);
          document.getElementById('monthly-revenue')!.textContent = `€${revenue.toFixed(2)}`;

          subsBody.innerHTML = proProfiles.length > 0 ? proProfiles.map(p => `
            <tr class="border-b border-primary/5 hover:bg-surface-light">
              <td class="px-4 py-3 text-sm text-text">${p.display_name || 'User'}</td>
              <td class="px-4 py-3 text-sm text-text-muted">${p.id.substring(0, 8)}...</td>
              <td class="px-4 py-3 text-sm text-text">Pro</td>
              <td class="px-4 py-3"><span class="px-2 py-0.5 rounded-full bg-success/10 text-success text-xs font-medium">Active</span></td>
              <td class="px-4 py-3 text-sm text-text">€0.99</td>
              <td class="px-4 py-3 text-sm text-text-muted">${new Date(p.updated_at).toLocaleDateString()}</td>
              <td class="px-4 py-3">
                <button class="cancel-sub-btn text-xs text-error hover:underline" data-user-id="${p.id}">Cancel</button>
              </td>
            </tr>
          `).join('') : '<tr><td colspan="7" class="px-4 py-8 text-center text-text-muted">No active subscriptions</td></tr>';

          // Cancel subscription handlers
          document.querySelectorAll('.cancel-sub-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
              const userId = btn.getAttribute('data-user-id');
              if (userId && confirm('Cancel this subscription? User will be downgraded to Free.')) {
                const { error } = await supabase.from('profiles').update({ plan: 'free' }).eq('id', userId);
                if (error) {
                  alert('Error: ' + error.message);
                } else {
                  alert('Subscription cancelled.');
                  loadAdminData();
                }
              }
            });
          });
        }
      }

      // Load data immediately
      loadAdminData();

      // Real-time subscriptions for live updates
      supabase
        .channel('admin-profiles')
        .on('postgres_changes', { event: '*', schema: 'public', table: 'profiles' }, () => {
          loadAdminData();
        })
        .subscribe();

      supabase
        .channel('admin-progress')
        .on('postgres_changes', { event: '*', schema: 'public', table: 'lesson_progress' }, () => {
          loadAdminData();
        })
        .subscribe();

      supabase
        .channel('admin-scores')
        .on('postgres_changes', { event: '*', schema: 'public', table: 'quiz_scores' }, () => {
          loadAdminData();
        })
        .subscribe();
    }

    // Tab switching
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab');
        document.querySelectorAll('.tab-btn').forEach(b => {
          b.classList.remove('active', 'bg-primary', 'text-white');
          b.classList.add('text-text-muted');
        });
        btn.classList.add('active', 'bg-primary', 'text-white');
        btn.classList.remove('text-text-muted');
        document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
        const content = document.getElementById(`tab-${tab}`);
        if (content) content.classList.remove('hidden');
      });
    });

    const firstTab = document.querySelector('.tab-btn');
    if (firstTab) {
      firstTab.classList.add('active', 'bg-primary', 'text-white');
      firstTab.classList.remove('text-text-muted');
    }

    // Save handlers
    document.getElementById('save-revolut')?.addEventListener('click', () => {
      const settings = {
        revolutApiKey: (document.getElementById('revolut-api-key') as HTMLInputElement)?.value || '',
        revolutWebhookSecret: (document.getElementById('revolut-webhook-secret') as HTMLInputElement)?.value || '',
        revolutMerchantId: (document.getElementById('revolut-merchant-id') as HTMLInputElement)?.value || '',
      };
      localStorage.setItem('adminSettings', JSON.stringify({ ...JSON.parse(localStorage.getItem('adminSettings') || '{}'), ...settings }));
      alert('Revolut settings saved!');
    });

    document.getElementById('save-supabase')?.addEventListener('click', () => {
      const settings = {
        supabaseUrl: (document.getElementById('supabase-url') as HTMLInputElement)?.value || '',
        supabaseAnonKey: (document.getElementById('supabase-anon-key') as HTMLInputElement)?.value || '',
        supabaseServiceKey: (document.getElementById('supabase-service-key') as HTMLInputElement)?.value || '',
      };
      localStorage.setItem('adminSettings', JSON.stringify({ ...JSON.parse(localStorage.getItem('adminSettings') || '{}'), ...settings }));
      alert('Supabase settings saved!');
    });

    // Load saved settings on page load
    const savedSettings = JSON.parse(localStorage.getItem('adminSettings') || '{}');
    const siteNameInput = document.getElementById('site-name') as HTMLInputElement;
    const logoUrlInput = document.getElementById('logo-url') as HTMLInputElement;
    const siteUrlInput = document.getElementById('site-url') as HTMLInputElement;
    if (savedSettings.siteName && siteNameInput) siteNameInput.value = savedSettings.siteName;
    if (savedSettings.logoUrl && logoUrlInput) logoUrlInput.value = savedSettings.logoUrl;
    if (savedSettings.siteUrl && siteUrlInput) siteUrlInput.value = savedSettings.siteUrl;

    // Logo preview
    function updateLogoPreview() {
      const preview = document.getElementById('logo-preview');
      const namePreview = document.getElementById('logo-name-preview');
      const logoUrl = logoUrlInput?.value;
      const siteName = siteNameInput?.value || 'NetworkLearn';
      if (preview) {
        if (logoUrl) {
          preview.innerHTML = `<img src="${logoUrl}" alt="Logo" class="w-10 h-10 rounded-xl object-cover" onerror="this.parentElement.innerHTML='N'" />`;
        } else {
          preview.innerHTML = '<span class="text-white font-bold text-xl">N</span>';
        }
      }
      if (namePreview) namePreview.textContent = siteName;
    }
    siteNameInput?.addEventListener('input', updateLogoPreview);
    logoUrlInput?.addEventListener('input', updateLogoPreview);
    updateLogoPreview();

    document.getElementById('save-general')?.addEventListener('click', () => {
      const settings = {
        siteName: siteNameInput?.value || 'NetworkLearn',
        logoUrl: logoUrlInput?.value || '',
        siteUrl: siteUrlInput?.value || '',
      };
      localStorage.setItem('adminSettings', JSON.stringify({ ...JSON.parse(localStorage.getItem('adminSettings') || '{}'), ...settings }));
      // Dispatch storage event so Header picks up changes
      window.dispatchEvent(new Event('storage'));
      alert('General settings saved! Logo will update on all pages.');
    });
    document.getElementById('save-email')?.addEventListener('click', () => alert('Email settings saved!'));
    document.getElementById('save-stripe')?.addEventListener('click', () => alert('Stripe settings saved!'));
  </script>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.tsx';
import Footer from '../../components/layout/Footer.tsx';
import en from '../../i18n/en.json';

const locale = 'en' as const;
const t = en;
---

<BaseLayout title="Reset Password" lang={locale}>
  <Header locale={locale} translations={t} client:load />

  <main class="pt-24 pb-16 min-h-screen flex items-center justify-center">
    <div class="w-full max-w-md mx-auto px-4">
      <div class="bg-surface-card rounded-2xl border border-primary/10 p-8">
        {/* Logo */}
        <div class="text-center mb-8">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-primary to-accent flex items-center justify-center text-white font-bold text-3xl mx-auto mb-4">
            NL
          </div>
          <h1 class="text-2xl font-bold text-text" id="reset-title">Reset Your Password</h1>
          <p class="text-sm text-text-muted mt-2" id="reset-subtitle">Enter your new password below</p>
        </div>

        {/* Password Reset Form */}
        <form id="reset-form" class="space-y-5">
          <div>
            <label for="new-password" class="block text-sm font-medium text-text mb-2">
              New Password
            </label>
            <input
              type="password"
              id="new-password"
              name="new-password"
              required
              class="w-full px-4 py-3 bg-surface border border-primary/10 rounded-xl text-text placeholder-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
              placeholder="••••••••"
            />
            <div id="password-requirements" class="mt-3 space-y-1">
              <p id="req-length" class="text-xs text-text-muted flex items-center gap-2">
                <span class="w-4 h-4 rounded-full border border-text-muted flex items-center justify-center text-[10px]">✗</span>
                At least 8 characters
              </p>
              <p id="req-upper" class="text-xs text-text-muted flex items-center gap-2">
                <span class="w-4 h-4 rounded-full border border-text-muted flex items-center justify-center text-[10px]">✗</span>
                At least 1 uppercase letter
              </p>
              <p id="req-lower" class="text-xs text-text-muted flex items-center gap-2">
                <span class="w-4 h-4 rounded-full border border-text-muted flex items-center justify-center text-[10px]">✗</span>
                At least 1 lowercase letter
              </p>
              <p id="req-number" class="text-xs text-text-muted flex items-center gap-2">
                <span class="w-4 h-4 rounded-full border border-text-muted flex items-center justify-center text-[10px]">✗</span>
                At least 1 number
              </p>
              <p id="req-special" class="text-xs text-text-muted flex items-center gap-2">
                <span class="w-4 h-4 rounded-full border border-text-muted flex items-center justify-center text-[10px]">✗</span>
                At least 1 special character (!@#$%^&*)
              </p>
            </div>
          </div>

          <div>
            <label for="confirm-password" class="block text-sm font-medium text-text mb-2">
              Confirm Password
            </label>
            <input
              type="password"
              id="confirm-password"
              name="confirm-password"
              required
              class="w-full px-4 py-3 bg-surface border border-primary/10 rounded-xl text-text placeholder-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
              placeholder="••••••••"
            />
            <p id="match-error" class="hidden text-xs text-error mt-1">Passwords do not match</p>
          </div>

          <button
            type="submit"
            id="submit-btn"
            disabled
            class="w-full py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity disabled:opacity-30 disabled:cursor-not-allowed"
          >
            Reset Password
          </button>
        </form>

        {/* Success Message (hidden by default) */}
        <div id="success-message" class="hidden text-center">
          <div class="text-6xl mb-4">✅</div>
          <h2 class="text-2xl font-bold text-text mb-2">Password Reset Successful!</h2>
          <p class="text-text-muted mb-6">Your password has been updated. You can now login with your new password.</p>
          <a
            href={`/${locale}/login`}
            class="inline-flex px-6 py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity"
          >
            Go to Login →
          </a>
        </div>

        {/* Error Message (hidden by default) */}
        <div id="error-message" class="hidden text-center">
          <div class="text-6xl mb-4">❌</div>
          <h2 class="text-2xl font-bold text-text mb-2">Reset Failed</h2>
          <p class="text-text-muted mb-6" id="error-text">The reset link is invalid or has expired.</p>
          <a
            href={`/${locale}/login`}
            class="inline-flex px-6 py-3 bg-primary/10 text-primary rounded-xl font-medium hover:bg-primary/20 transition-colors"
          >
            Back to Login
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer locale={locale} translations={t} />

  <script>
    import { createClient } from '@supabase/supabase-js';

    const supabase = createClient(
      'https://jhesstimsojwmkdysmpy.supabase.co',
      'sb_publishable_bKD9biIulcfC5iNipD-8IA_3Zu4bmWD'
    );

    const form = document.getElementById('reset-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const newPassInput = document.getElementById('new-password') as HTMLInputElement;
    const confirmPassInput = document.getElementById('confirm-password') as HTMLInputElement;
    const successMsg = document.getElementById('success-message');
    const errorMsg = document.getElementById('error-message');
    const errorText = document.getElementById('error-text');
    const matchError = document.getElementById('match-error');

    // Password requirement elements
    const reqLength = document.getElementById('req-length');
    const reqUpper = document.getElementById('req-upper');
    const reqLower = document.getElementById('req-lower');
    const reqNumber = document.getElementById('req-number');
    const reqSpecial = document.getElementById('req-special');

    // Check if we have a valid session from the reset link
    async function checkSession() {
      const { data: { session } } = await supabase.auth.getSession();
      // Supabase handles the token from the URL automatically
      // If no session, the user might need to click the link again
    }
    checkSession();

    // Update requirement indicators
    function updateRequirements(password: string) {
      const checks = {
        length: password.length >= 8,
        upper: /[A-Z]/.test(password),
        lower: /[a-z]/.test(password),
        number: /[0-9]/.test(password),
        special: /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(password),
      };

      const updateEl = (el: HTMLElement | null, met: boolean) => {
        if (!el) return;
        const span = el.querySelector('span');
        if (span) {
          span.textContent = met ? '✓' : '✗';
          span.className = met
            ? 'w-4 h-4 rounded-full bg-success text-white flex items-center justify-center text-[10px]'
            : 'w-4 h-4 rounded-full border border-text-muted flex items-center justify-center text-[10px]';
        }
        el.className = met ? 'text-xs text-success flex items-center gap-2' : 'text-xs text-text-muted flex items-center gap-2';
      };

      updateEl(reqLength, checks.length);
      updateEl(reqUpper, checks.upper);
      updateEl(reqLower, checks.lower);
      updateEl(reqNumber, checks.number);
      updateEl(reqSpecial, checks.special);

      // Check if all requirements are met
      const allMet = Object.values(checks).every(Boolean);
      const passwordsMatch = newPassInput.value === confirmPassInput.value && confirmPassInput.value.length > 0;

      submitBtn.disabled = !(allMet && passwordsMatch);

      // Show/hide match error
      if (confirmPassInput.value.length > 0 && !passwordsMatch) {
        matchError?.classList.remove('hidden');
      } else {
        matchError?.classList.add('hidden');
      }
    }

    // Listen for password input
    newPassInput?.addEventListener('input', () => updateRequirements(newPassInput.value));
    confirmPassInput?.addEventListener('input', () => updateRequirements(newPassInput.value));

    // Form submission
    form?.addEventListener('async', async (e) => {
      e.preventDefault();
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const newPassword = newPassInput.value;
      const confirmPassword = confirmPassInput.value;

      if (newPassword !== confirmPassword) {
        matchError?.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Updating...';

      try {
        const { error } = await supabase.auth.updateUser({
          password: newPassword,
        });

        if (error) {
          throw error;
        }

        // Success!
        form.classList.add('hidden');
        successMsg?.classList.remove('hidden');
      } catch (err: any) {
        // Show error
        form.classList.add('hidden');
        errorMsg?.classList.remove('hidden');
        if (errorText) errorText.textContent = err.message || 'The reset link is invalid or has expired. Please request a new one.';
      }
    });
  </script>
</BaseLayout>

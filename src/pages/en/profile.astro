---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.tsx';
import Footer from '../../components/layout/Footer.tsx';
import en from '../../i18n/en.json';

const locale = 'en' as const;
const t = en;
---

<BaseLayout title={t.profile.title} lang={locale}>
  <Header locale={locale} translations={t} client:load />

  <main class="pt-24 pb-16 min-h-screen">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold mb-8">{t.profile.title}</h1>

      {/* Profile form */}
      <div class="bg-surface-card rounded-2xl border border-primary/10 p-8 mb-8">
        <h2 class="text-xl font-bold mb-6">Account Information</h2>

        <form id="profile-form" class="space-y-6">
          {/* Profile Picture */}
          <div class="flex items-center gap-6">
            <div class="relative">
              <div id="avatar-preview" class="w-24 h-24 rounded-full bg-gradient-to-br from-primary to-accent flex items-center justify-center text-white font-bold text-3xl overflow-hidden">
                <span id="avatar-letter">U</span>
                <img id="avatar-img" src="" alt="Profile" class="w-full h-full object-cover hidden" />
              </div>
              <label for="avatar-upload" class="absolute bottom-0 right-0 w-8 h-8 bg-primary rounded-full flex items-center justify-center cursor-pointer hover:bg-primary-dark transition-colors shadow-lg">
                <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </label>
              <input type="file" id="avatar-upload" accept="image/*" class="hidden" />
            </div>
            <div>
              <h3 class="font-medium text-text">Profile Picture</h3>
              <p class="text-sm text-text-muted">Upload a photo for your profile</p>
              <p class="text-xs text-text-muted mt-1">JPG, PNG or WebP. Max 2MB.</p>
              <button type="button" id="remove-avatar" class="hidden text-xs text-error mt-2 hover:underline">Remove photo</button>
            </div>
          </div>

          <div>
            <label for="display-name" class="block text-sm font-medium text-text mb-2">
              {t.profile.display_name}
            </label>
            <input
              type="text"
              id="display-name"
              name="display-name"
              class="w-full px-4 py-3 bg-surface border border-primary/10 rounded-xl text-text placeholder-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
              placeholder="Your name"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-text mb-2">
              {t.auth.email}
            </label>
            <input
              type="email"
              id="email"
              name="email"
              disabled
              class="w-full px-4 py-3 bg-surface-light border border-primary/10 rounded-xl text-text-muted cursor-not-allowed"
            />
            <p class="text-xs text-text-muted mt-1">Email cannot be changed</p>
          </div>

          <div>
            <label class="block text-sm font-medium text-text mb-2">
              {t.profile.language}
            </label>
            <div class="flex gap-3">
              <button
                type="button"
                class="lang-btn flex-1 px-4 py-3 rounded-xl border-2 border-primary bg-primary/10 text-primary font-medium transition-all"
                data-lang="en"
              >
                🇬🇧 English
              </button>
              <button
                type="button"
                class="lang-btn flex-1 px-4 py-3 rounded-xl border border-primary/10 text-text-muted hover:border-primary/30 transition-all"
                data-lang="el"
              >
                🇬🇷 Ελληνικά
              </button>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-text mb-2">
              {t.profile.theme}
            </label>
            <div class="flex gap-3">
              <button
                type="button"
                class="theme-btn flex-1 px-4 py-3 rounded-xl border-2 border-primary bg-primary/10 text-primary font-medium transition-all flex items-center justify-center gap-2"
                data-theme="dark"
              >
                🌙 {t.profile.dark}
              </button>
              <button
                type="button"
                class="theme-btn flex-1 px-4 py-3 rounded-xl border border-primary/10 text-text-muted hover:border-primary/30 transition-all flex items-center justify-center gap-2"
                data-theme="light"
              >
                ☀️ {t.profile.light}
              </button>
            </div>
          </div>

          <button
            type="submit"
            class="w-full py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity"
          >
            {t.profile.save}
          </button>
        </form>
      </div>

      {/* Plan status */}
      <div class="bg-surface-card rounded-2xl border border-primary/10 p-8 mb-8">
        <h2 class="text-xl font-bold mb-4">{t.profile.plan}</h2>
        <div class="flex items-center justify-between p-4 bg-surface-light rounded-xl" id="plan-status">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary to-accent flex items-center justify-center text-white font-bold text-lg" id="plan-icon">
              F
            </div>
            <div>
              <div class="font-bold text-text" id="plan-name">{t.pricing.free} Plan</div>
              <div class="text-sm text-text-muted" id="plan-desc">Basic access to all lessons</div>
            </div>
          </div>
          <a
            href={`/${locale}/pricing`}
            class="px-4 py-2 bg-primary/10 text-primary rounded-lg text-sm font-medium hover:bg-primary/20 transition-colors"
            id="plan-action"
          >
            {t.pricing.upgrade}
          </a>
        </div>
      </div>

      {/* Security */}
      <div class="bg-surface-card rounded-2xl border border-primary/10 p-8 mb-8">
        <h2 class="text-xl font-bold mb-4">🔐 Security</h2>
        <div class="space-y-4">
          <div class="flex items-center justify-between p-4 bg-surface-light rounded-xl">
            <div>
              <div class="font-medium text-text">Password</div>
              <div class="text-sm text-text-muted">Reset your password via email</div>
            </div>
            <button
              id="reset-password-btn"
              class="px-4 py-2 bg-primary/10 text-primary rounded-lg text-sm font-medium hover:bg-primary/20 transition-colors"
            >
              Reset Password
            </button>
          </div>
        </div>
      </div>

      {/* GDPR Section */}
      <div class="bg-surface-card rounded-2xl border border-primary/10 p-8 mb-8">
        <h2 class="text-xl font-bold mb-2">Data & Privacy</h2>
        <p class="text-text-muted text-sm mb-6">{t.profile.gdpr_notice}</p>

        <div class="space-y-4">
          {/* Delete account */}
          <button
            id="delete-account-btn"
            class="w-full flex items-center justify-between p-4 bg-error/5 rounded-xl border border-error/20 hover:bg-error/10 transition-colors"
          >
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-error/10 flex items-center justify-center text-xl">🗑️</div>
              <div class="text-left">
                <div class="font-medium text-error">{t.profile.delete_account}</div>
                <div class="text-xs text-text-muted">Permanently delete your account and data</div>
              </div>
            </div>
            <svg class="w-5 h-5 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>

      {/* Legal links */}
      <div class="flex flex-wrap gap-4 text-sm text-text-muted">
        <a href={`/${locale}/privacy`} class="hover:text-primary">{t.gdpr.privacy_policy}</a>
        <span>•</span>
        <a href={`/${locale}/terms`} class="hover:text-primary">{t.gdpr.terms_of_service}</a>
      </div>
    </div>
  </main>

  <Footer locale={locale} translations={t} />

  <script>
    import { supabase } from '../../lib/supabase';

    // Load user profile and plan
    async function loadProfile() {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) {
        window.location.href = '/en/login';
        return;
      }

      const user = session.user;

      // Fetch profile
      const { data: profile } = await supabase
        .from('profiles')
        .select('*')
        .eq('id', user.id)
        .single();

      // Update form fields
      const nameInput = document.getElementById('display-name') as HTMLInputElement;
      const emailInput = document.getElementById('email') as HTMLInputElement;
      if (nameInput) nameInput.value = profile?.display_name || user.user_metadata?.display_name || '';
      if (emailInput) emailInput.value = user.email || '';

      // Update avatar
      const avatarLetter = document.getElementById('avatar-letter');
      const avatarImg = document.getElementById('avatar-img') as HTMLImageElement;
      const removeBtn = document.getElementById('remove-avatar');
      const displayName = profile?.display_name || user.user_metadata?.display_name || user.email?.split('@')[0] || 'U';

      if (avatarLetter) avatarLetter.textContent = displayName.charAt(0).toUpperCase();

      if (profile?.avatar_url) {
        if (avatarImg) {
          avatarImg.src = profile.avatar_url;
          avatarImg.classList.remove('hidden');
          if (avatarLetter) avatarLetter.style.display = 'none';
          if (removeBtn) removeBtn.classList.remove('hidden');
        }
      }

      // Update plan status
      const planIcon = document.getElementById('plan-icon');
      const planName = document.getElementById('plan-name');
      const planDesc = document.getElementById('plan-desc');
      const planAction = document.getElementById('plan-action');

      if (profile?.plan === 'pro') {
        if (planIcon) {
          planIcon.textContent = 'P';
          planIcon.className = 'w-12 h-12 rounded-xl bg-gradient-to-br from-accent to-primary flex items-center justify-center text-white font-bold text-lg';
        }
        if (planName) planName.textContent = 'Pro Plan';
        if (planDesc) planDesc.textContent = 'Full access to quizzes, certificates, and more';
        if (planAction) {
          planAction.textContent = 'Active ✓';
          planAction.className = 'px-4 py-2 bg-success/10 text-success rounded-lg text-sm font-medium cursor-default';
          planAction.removeAttribute('href');
        }
      }
    }

    loadProfile();

    // Password reset
    document.getElementById('reset-password-btn')?.addEventListener('click', async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user?.email) return;

      if (confirm(`Send password reset email to ${session.user.email}?`)) {
        const { error } = await supabase.auth.resetPasswordForEmail(session.user.email, {
          redirectTo: window.location.origin + '/en/reset-password',
        });
        if (error) {
          alert('Error: ' + error.message);
        } else {
          alert('Password reset email sent! Check your inbox.');
        }
      }
    });

    // Avatar upload
    document.getElementById('avatar-upload')?.addEventListener('change', async (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;

      // Validate file
      if (file.size > 2 * 1024 * 1024) {
        alert('File too large. Maximum size is 2MB.');
        return;
      }
      if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) {
        alert('Invalid file type. Please upload JPG, PNG or WebP.');
        return;
      }

      // Convert to base64
      const reader = new FileReader();
      reader.onload = async function() {
        const base64 = reader.result as string;

        // Update preview
        const avatarImg = document.getElementById('avatar-img') as HTMLImageElement;
        const avatarLetter = document.getElementById('avatar-letter');
        const removeBtn = document.getElementById('remove-avatar');

        if (avatarImg) {
          avatarImg.src = base64;
          avatarImg.classList.remove('hidden');
        }
        if (avatarLetter) avatarLetter.style.display = 'none';
        if (removeBtn) removeBtn.classList.remove('hidden');

        // Save to Supabase
        const { data: { session } } = await supabase.auth.getSession();
        if (session?.user) {
          await supabase
            .from('profiles')
            .update({ avatar_url: base64 })
            .eq('id', session.user.id);

          // Also save to localStorage for header
          localStorage.setItem('userAvatar', base64);
          alert('Profile picture updated!');
        }
      };
      reader.readAsDataURL(file);
    });

    // Remove avatar
    document.getElementById('remove-avatar')?.addEventListener('click', async () => {
      const avatarImg = document.getElementById('avatar-img') as HTMLImageElement;
      const avatarLetter = document.getElementById('avatar-letter');
      const removeBtn = document.getElementById('remove-avatar');

      if (avatarImg) { avatarImg.src = ''; avatarImg.classList.add('hidden'); }
      if (avatarLetter) avatarLetter.style.display = 'flex';
      if (removeBtn) removeBtn.classList.add('hidden');

      localStorage.removeItem('userAvatar');

      const { data: { session } } = await supabase.auth.getSession();
      if (session?.user) {
        await supabase.from('profiles').update({ avatar_url: null }).eq('id', session.user.id);
      }
      alert('Profile picture removed.');
    });

    // Theme toggle
    document.querySelectorAll('.theme-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const theme = btn.getAttribute('data-theme') || 'dark';
        document.documentElement.classList.toggle('dark', theme === 'dark');
        document.documentElement.classList.toggle('light', theme === 'light');
        localStorage.setItem('theme', theme);
        document.querySelectorAll('.theme-btn').forEach(b => {
          b.classList.remove('border-primary', 'bg-primary/10', 'text-primary');
          b.classList.add('border-primary/10', 'text-text-muted');
        });
        btn.classList.add('border-primary', 'bg-primary/10', 'text-primary');
        btn.classList.remove('border-primary/10', 'text-text-muted');
      });
    });

    // Language toggle
    document.querySelectorAll('.lang-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-lang') || 'en';
        window.location.href = `/${lang}/profile`;
      });
    });

    // Delete account (GDPR) — uses server-side RPC for security
    document.getElementById('delete-account-btn')?.addEventListener('click', async () => {
      const confirmMsg = 'Are you sure you want to delete your account?\n\nThis will permanently delete:\n• All your lesson progress\n• All quiz scores\n• Your points and streak\n• Your profile data\n\nThis action CANNOT be undone.';
      if (confirm(confirmMsg)) {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session?.user) return;

        const btn = document.getElementById('delete-account-btn');
        if (btn) { btn.textContent = 'Deleting...'; (btn as HTMLButtonElement).disabled = true; }

        try {
          // Use server-side RPC for account deletion (deletes auth.users too)
          const { error } = await supabase.rpc('delete_user_account', { target_user_id: session.user.id });
          if (error) throw error;

          // Clear localStorage
          localStorage.removeItem('userEmail');
          localStorage.removeItem('userId');
          localStorage.removeItem('userAvatar');
          localStorage.removeItem(`completedLessons_${session.user.id}`);

          // Sign out
          await supabase.auth.signOut();

          alert('Your account has been deleted. All data has been permanently removed.');
          window.location.href = '/en/';
        } catch (error: any) {
          alert('Error deleting account: ' + (error.message || 'Please try again or contact support.'));
          if (btn) { btn.textContent = t.profile.delete_account; (btn as HTMLButtonElement).disabled = false; }
        }
      }
    });

    // Profile form
    document.getElementById('profile-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) return;

      const displayName = (document.getElementById('display-name') as HTMLInputElement)?.value;
      const { error } = await supabase
        .from('profiles')
        .update({ display_name: displayName })
        .eq('id', session.user.id);

      if (error) {
        alert('Error: ' + error.message);
      } else {
        alert('Profile saved!');
      }
    });
  </script>
</BaseLayout>

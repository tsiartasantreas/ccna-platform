---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.tsx';
import Footer from '../../components/layout/Footer.tsx';
import en from '../../i18n/en.json';

const locale = 'en' as const;
const t = en;
---

<BaseLayout title={t.auth.login_title} lang={locale}>
  <Header locale={locale} translations={t} client:load />

  <main class="pt-24 pb-16 min-h-screen flex items-center justify-center">
    <div class="w-full max-w-md mx-auto px-4">
      <div class="bg-surface-card rounded-2xl border border-primary/10 p-8">
        {/* Logo */}
        <div class="text-center mb-8">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-primary to-accent flex items-center justify-center text-white font-bold text-3xl mx-auto mb-4">
            N
          </div>
          <h1 class="text-2xl font-bold text-text" id="auth-title">{t.auth.login_title}</h1>
        </div>

        {/* Auth form */}
        <form id="auth-form" class="space-y-5">
          {/* Display name - signup only */}
          <div id="name-field" class="hidden">
            <label for="display-name" class="block text-sm font-medium text-text mb-2">
              {t.auth.display_name}
            </label>
            <input
              type="text"
              id="display-name"
              name="display-name"
              class="w-full px-4 py-3 bg-surface border border-primary/10 rounded-xl text-text placeholder-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
              placeholder="John Doe"
            />
          </div>

          {/* Email */}
          <div>
            <label for="email" class="block text-sm font-medium text-text mb-2">
              {t.auth.email}
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 bg-surface border border-primary/10 rounded-xl text-text placeholder-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
              placeholder="you@example.com"
            />
          </div>

          {/* Password */}
          <div>
            <label for="password" class="block text-sm font-medium text-text mb-2">
              {t.auth.password}
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              minlength="8"
              class="w-full px-4 py-3 bg-surface border border-primary/10 rounded-xl text-text placeholder-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
              placeholder="••••••••"
            />
            <p id="password-requirements" class="hidden text-xs text-text-muted mt-2">
              Min 8 chars: 1 uppercase, 1 lowercase, 1 number, 1 special character
            </p>
          </div>

          {/* Confirm password - signup only */}
          <div id="confirm-field" class="hidden">
            <label for="confirm-password" class="block text-sm font-medium text-text mb-2">
              {t.auth.confirm_password}
            </label>
            <input
              type="password"
              id="confirm-password"
              name="confirm-password"
              minlength="8"
              class="w-full px-4 py-3 bg-surface border border-primary/10 rounded-xl text-text placeholder-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
              placeholder="••••••••"
            />
          </div>

          {/* Submit button */}
          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity"
          >
            {t.auth.login_button}
          </button>
        </form>

        {/* Divider */}
        <div class="flex items-center gap-4 my-6">
          <div class="flex-grow h-px bg-primary/10"></div>
          <span class="text-sm text-text-muted">{t.auth.or_continue}</span>
          <div class="flex-grow h-px bg-primary/10"></div>
        </div>

        {/* Google OAuth */}
        <button class="w-full py-3 border border-primary/10 rounded-xl font-medium text-text hover:bg-surface-light transition-colors flex items-center justify-center gap-3">
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          {t.auth.google}
        </button>

        {/* Toggle auth mode */}
        <p class="text-center mt-6 text-sm text-text-muted">
          <span id="toggle-text">{t.auth.no_account}</span>
          {' '}
          <button id="toggle-auth" class="text-primary hover:underline font-medium">
            {t.auth.signup_button}
          </button>
        </p>

        {/* Forgot password - login only */}
        <p id="forgot-link" class="text-center mt-3">
          <a href="#" class="text-sm text-text-muted hover:text-primary">
            {t.auth.forgot_password}
          </a>
        </p>
      </div>
    </div>
  </main>

  <Footer locale={locale} translations={t} />

  <script>
    import { createClient } from '@supabase/supabase-js';

    const supabaseUrl = 'https://jhesstimsojwmkdysmpy.supabase.co';
    const supabaseKey = 'sb_publishable_bKD9biIulcfC5iNipD-8IA_3Zu4bmWD';
    const supabase = createClient(supabaseUrl, supabaseKey);

    const ADMIN_EMAIL = 'tsiartasantreas@gmail.com';

    let isSignup = false;

    const title = document.getElementById('auth-title');
    const nameField = document.getElementById('name-field');
    const confirmField = document.getElementById('confirm-field');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const toggleBtn = document.getElementById('toggle-auth');
    const toggleText = document.getElementById('toggle-text');
    const forgotLink = document.getElementById('forgot-link');

    // Check URL params
    const params = new URLSearchParams(window.location.search);
    if (params.get('mode') === 'signup') toggleMode();

    // Check if already logged in
    const { data: { session } } = await supabase.auth.getSession();
    if (session?.user) {
      localStorage.setItem('userEmail', session.user.email || '');
      localStorage.setItem('userId', session.user.id);
      window.location.href = '/en/dashboard';
    }

    function toggleMode() {
      isSignup = !isSignup;
      if (title) title.textContent = isSignup ? 'Create Account' : 'Welcome Back';
      if (nameField) nameField.classList.toggle('hidden', !isSignup);
      if (confirmField) confirmField.classList.toggle('hidden', !isSignup);
      if (submitBtn) submitBtn.textContent = isSignup ? 'Sign Up' : 'Login';
      if (toggleText) toggleText.textContent = isSignup ? 'Already have an account?' : "Don't have an account?";
      if (toggleBtn) toggleBtn.textContent = isSignup ? 'Login' : 'Sign Up';
      if (forgotLink) forgotLink.classList.toggle('hidden', isSignup);
      // Show/hide password requirements
      const req = document.getElementById('password-requirements');
      if (req) req.classList.toggle('hidden', !isSignup);
    }

    toggleBtn?.addEventListener('click', toggleMode);

    // Forgot password
    forgotLink?.querySelector('a')?.addEventListener('click', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('email') as HTMLInputElement)?.value;
      if (!email) {
        alert('Please enter your email address first.');
        return;
      }
      const { error } = await supabase.auth.resetPasswordForEmail(email, {
        redirectTo: window.location.origin + '/en/login?mode=reset',
      });
      if (error) {
        alert('Error: ' + error.message);
      } else {
        alert('Password reset email sent! Check your inbox.');
      }
    });

    // Password validation
    function validatePassword(password: string): string | null {
      if (password.length < 8) return 'Password must be at least 8 characters long.';
      if (!/[A-Z]/.test(password)) return 'Password must contain at least 1 uppercase letter.';
      if (!/[a-z]/.test(password)) return 'Password must contain at least 1 lowercase letter.';
      if (!/[0-9]/.test(password)) return 'Password must contain at least 1 number.';
      if (!/[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(password)) return 'Password must contain at least 1 special character.';
      return null;
    }

    // Form submission
    document.getElementById('auth-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitBtn) submitBtn.disabled = true;
      if (submitBtn) submitBtn.textContent = 'Processing...';

      const email = (document.getElementById('email') as HTMLInputElement)?.value;
      const password = (document.getElementById('password') as HTMLInputElement)?.value;
      const displayName = (document.getElementById('display-name') as HTMLInputElement)?.value;

      // Validate password for signup
      if (isSignup) {
        const passwordError = validatePassword(password || '');
        if (passwordError) {
          alert(passwordError);
          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Sign Up'; }
          return;
        }
      }

      try {
        if (isSignup) {
          // Sign up
          const { data, error } = await supabase.auth.signUp({
            email,
            password,
            options: {
              data: { display_name: displayName || email?.split('@')[0] },
            },
          });
          if (error) throw error;
          if (data.user) {
            localStorage.setItem('userEmail', data.user.email || '');
            localStorage.setItem('userId', data.user.id);
            if (data.user.identities?.length === 0) {
              alert('An account with this email already exists. Please login instead.');
            } else {
              alert('Account created! Please check your email to verify your account.');
              window.location.href = '/en/dashboard';
            }
          }
        } else {
          // Login
          const { data, error } = await supabase.auth.signInWithPassword({
            email,
            password,
          });
          if (error) throw error;
          if (data.user) {
            localStorage.setItem('userEmail', data.user.email || '');
            localStorage.setItem('userId', data.user.id);
            window.location.href = '/en/dashboard';
          }
        }
      } catch (err: any) {
        alert('Error: ' + (err.message || 'Authentication failed'));
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (submitBtn) submitBtn.textContent = isSignup ? 'Sign Up' : 'Login';
      }
    });
  </script>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.tsx';
import Footer from '../../components/layout/Footer.tsx';
import en from '../../i18n/en.json';

const locale = 'en' as const;
const t = en;
---

<BaseLayout title="Contact Us" description="Get in touch with the NetAcad team" lang={locale}>
  <Header locale={locale} translations={t} client:load />

  <main class="pt-24 pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-text mb-4">Contact Us</h1>
        <p class="text-text-muted text-lg">Have questions? We'd love to hear from you.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        {/* Contact Info */}
        <div class="space-y-6">
          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-2xl">📧</div>
              <div>
                <h3 class="font-bold text-text">Email</h3>
                <a href="mailto:tsiartasantreas@gmail.com" class="text-primary hover:underline">tsiartasantreas@gmail.com</a>
              </div>
            </div>
            <p class="text-sm text-text-muted">We typically respond within 24-48 hours.</p>
          </div>

          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center text-2xl">⏱️</div>
              <div>
                <h3 class="font-bold text-text">Response Time</h3>
                <p class="text-text-muted">Monday - Friday, 9:00 - 18:00 EET</p>
              </div>
            </div>
          </div>

          <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-12 h-12 rounded-xl bg-success/10 flex items-center justify-center text-2xl">💬</div>
              <div>
                <h3 class="font-bold text-text">Support Topics</h3>
                <ul class="text-text-muted text-sm mt-2 space-y-1">
                  <li>• Account issues</li>
                  <li>• Billing & subscriptions</li>
                  <li>• Technical problems</li>
                  <li>• Content feedback</li>
                  <li>• Partnership inquiries</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        {/* Contact Form */}
        <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
          <h3 class="text-xl font-bold text-text mb-6">Send us a Message</h3>
          <form id="contact-form" class="space-y-4">
            <div>
              <label for="contact-name" class="block text-sm font-medium text-text mb-1">Name</label>
              <input type="text" id="contact-name" name="name" required class="w-full px-4 py-3 bg-surface border border-primary/10 rounded-xl text-text placeholder-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Your name" />
            </div>
            <div>
              <label for="contact-email" class="block text-sm font-medium text-text mb-1">Email</label>
              <input type="email" id="contact-email" name="email" required class="w-full px-4 py-3 bg-surface border border-primary/10 rounded-xl text-text placeholder-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="your@email.com" />
            </div>
            <div>
              <label for="contact-subject" class="block text-sm font-medium text-text mb-1">Subject</label>
              <select id="contact-subject" name="subject" class="w-full px-4 py-3 bg-surface border border-primary/10 rounded-xl text-text focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all">
                <option value="general">General Inquiry</option>
                <option value="account">Account Issue</option>
                <option value="billing">Billing & Subscription</option>
                <option value="technical">Technical Problem</option>
                <option value="feedback">Content Feedback</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div>
              <label for="contact-message" class="block text-sm font-medium text-text mb-1">Message</label>
              <textarea id="contact-message" name="message" rows="5" required class="w-full px-4 py-3 bg-surface border border-primary/10 rounded-xl text-text placeholder-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all resize-none" placeholder="How can we help you?"></textarea>
            </div>
            <button type="submit" class="w-full py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity">
              Send Message
            </button>
          </form>
        </div>
      </div>

      {/* FAQ */}
      <div class="mt-12">
        <h2 class="text-2xl font-bold text-text text-center mb-8">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {[
            { q: 'Is NetAcad affiliated with Cisco?', a: 'No, NetAcad is an independent educational platform. CCNA® is a registered trademark of Cisco Systems, Inc.' },
            { q: 'How do I reset my password?', a: 'Go to the login page and click "Forgot Password". You\'ll receive a reset link via email.' },
            { q: 'Can I get a refund?', a: 'Yes, we offer a 14-day money-back guarantee. Contact us within 14 days of your purchase for a full refund.' },
            { q: 'How do I cancel my subscription?', a: 'Go to your Profile settings and manage your subscription, or contact us for assistance.' },
          ].map((faq) => (
            <div class="bg-surface-card rounded-xl border border-primary/10 p-6">
              <h3 class="font-bold text-text mb-2">{faq.q}</h3>
              <p class="text-text-muted">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </main>

  <Footer locale={locale} translations={t} />

  <script>
    document.getElementById('contact-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('contact-name') as HTMLInputElement)?.value;
      const email = (document.getElementById('contact-email') as HTMLInputElement)?.value;
      const subject = (document.getElementById('contact-subject') as HTMLSelectElement)?.value;
      const message = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value;

      // In production, this would send to an API endpoint
      alert(`Thank you, ${name}! Your message has been received. We'll respond to ${email} within 24-48 hours.`);
      (e.target as HTMLFormElement).reset();
    });
  </script>
</BaseLayout>

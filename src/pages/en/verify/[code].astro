---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/layout/Header.tsx';
import Footer from '../../../components/layout/Footer.tsx';
import en from '../../../i18n/en.json';

export function getStaticPaths() {
  return [];
}

const locale = 'en';
const t = en;
const { code } = Astro.params;
---

<BaseLayout title="Certificate Verification" description="Verify a NetworkLearn certificate" lang={locale}>
  <Header locale={locale} translations={t} client:load />

  <main class="pt-24 pb-16 min-h-screen">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Loading State */}
      <div id="loading-state" class="text-center py-12">
        <div class="animate-spin w-12 h-12 border-4 border-primary border-t-transparent rounded-full mx-auto mb-4"></div>
        <p class="text-text-muted">Verifying certificate...</p>
      </div>

      {/* Valid Certificate */}
      <div id="valid-cert" class="hidden">
        <div class="bg-surface-card rounded-2xl border border-primary/20 overflow-hidden">
          {/* Header */}
          <div class="bg-gradient-to-r from-primary to-accent p-8 text-center">
            <div class="text-5xl mb-3">✅</div>
            <h1 class="text-2xl font-bold text-white mb-1">Certificate Verified</h1>
            <p class="text-white/80 text-sm">This certificate is authentic and valid</p>
          </div>

          {/* Certificate Details */}
          <div class="p-8 space-y-6">
            {/* Recipient */}
            <div class="text-center">
              <div class="text-sm text-text-muted mb-1">Awarded to</div>
              <div id="cert-name" class="text-3xl font-bold gradient-text"></div>
            </div>

            {/* Program */}
            <div class="text-center">
              <div class="text-sm text-text-muted mb-1">For completing</div>
              <div class="text-xl font-bold text-text">Network Engineering Program</div>
            </div>

            {/* Details Grid */}
            <div class="grid grid-cols-2 gap-4 pt-4 border-t border-primary/10">
              <div class="bg-surface-light rounded-xl p-4 text-center">
                <div class="text-sm text-text-muted mb-1">Issued On</div>
                <div id="cert-date" class="text-lg font-bold text-text"></div>
              </div>
              <div class="bg-surface-light rounded-xl p-4 text-center">
                <div class="text-sm text-text-muted mb-1">Average Score</div>
                <div id="cert-score" class="text-lg font-bold text-primary"></div>
              </div>
            </div>

            {/* Verification Code */}
            <div class="bg-surface-light rounded-xl p-4">
              <div class="text-sm text-text-muted mb-2">Verification Code</div>
              <div id="cert-code" class="text-lg font-mono font-bold text-primary"></div>
            </div>

            {/* Quiz Scores */}
            <div id="quiz-scores-section" class="hidden">
              <div class="text-sm text-text-muted mb-3">Module Scores</div>
              <div id="quiz-scores" class="space-y-2"></div>
            </div>

            {/* Share */}
            <div class="pt-4 border-t border-primary/10">
              <div class="text-sm text-text-muted mb-3">Share this certificate</div>
              <div class="flex gap-3">
                <button onclick="navigator.clipboard.writeText(window.location.href); alert('Link copied!')" class="flex-1 px-4 py-2 bg-primary text-white rounded-lg text-sm font-medium hover:opacity-90">
                  Copy Link
                </button>
                <a href={`https://twitter.com/intent/tweet?text=I%20completed%20the%20Network%20Engineering%20Program%20at%20NetworkLearn!&url=${encodeURIComponent(Astro.url.href)}`} target="_blank" class="flex-1 px-4 py-2 border border-primary/30 text-primary rounded-lg text-sm font-medium hover:bg-primary/10 text-center">
                  Share on X
                </a>
              </div>
            </div>
          </div>
        </div>

        {/* Back to Platform */}
        <div class="text-center mt-8">
          <a href={`/${locale}/`} class="text-primary hover:underline text-sm">
            ← Back to NetworkLearn
          </a>
        </div>
      </div>

      {/* Invalid Certificate */}
      <div id="invalid-cert" class="hidden">
        <div class="bg-surface-card rounded-2xl border border-error/20 overflow-hidden">
          {/* Header */}
          <div class="bg-gradient-to-r from-error to-red-600 p-8 text-center">
            <div class="text-5xl mb-3">❌</div>
            <h1 class="text-2xl font-bold text-white mb-1">Certificate Not Found</h1>
            <p class="text-white/80 text-sm">This verification code is invalid or the certificate has been revoked</p>
          </div>

          {/* Details */}
          <div class="p-8 text-center">
            <div class="bg-surface-light rounded-xl p-4 mb-6">
              <div class="text-sm text-text-muted mb-2">Verification Code Checked</div>
              <div class="text-lg font-mono font-bold text-error">{code}</div>
            </div>

            <p class="text-text-muted mb-6">
              This could mean:
            </p>
            <ul class="text-left text-text-muted text-sm space-y-2 mb-6 max-w-md mx-auto">
              <li class="flex items-start gap-2">
                <span class="text-error mt-1">•</span>
                <span>The verification code is incorrect</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-error mt-1">•</span>
                <span>The certificate has been revoked by an administrator</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-error mt-1">•</span>
                <span>The link may be incomplete or corrupted</span>
              </li>
            </ul>

            <a href={`/${locale}/`} class="inline-flex px-6 py-3 bg-gradient-to-r from-primary to-accent text-white rounded-xl font-medium hover:opacity-90 transition-opacity">
              Go to NetworkLearn
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer locale={locale} translations={t} />

  <script define:vars={{ verificationCode: code }}>
    import { supabase } from '../../../lib/supabase';

    async function verifyCertificate() {
      const loadingState = document.getElementById('loading-state');
      const validCert = document.getElementById('valid-cert');
      const invalidCert = document.getElementById('invalid-cert');

      try {
        const { data, error } = await supabase.rpc('verify_certificate', {
          p_verification_code: verificationCode
        });

        if (error || !data || data.is_valid === false) {
          loadingState.classList.add('hidden');
          invalidCert.classList.remove('hidden');
          return;
        }

        // Populate certificate details
        document.getElementById('cert-name').textContent = data.user_name || 'Certificate Holder';
        document.getElementById('cert-date').textContent = new Date(data.issued_at).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        });
        document.getElementById('cert-score').textContent = `${Math.round(data.total_score || 0)}%`;
        document.getElementById('cert-code').textContent = data.verification_code;

        // Show quiz scores if available
        if (data.quiz_scores && data.quiz_scores.length > 0) {
          const moduleNames = ['Network Fundamentals', 'Network Access', 'IP Connectivity', 'IP Services', 'Security Fundamentals', 'Automation & Programmability'];
          const quizScoresSection = document.getElementById('quiz-scores-section');
          const quizScoresDiv = document.getElementById('quiz-scores');

          quizScoresSection.classList.remove('hidden');
          quizScoresDiv.innerHTML = data.quiz_scores.map(score => `
            <div class="flex items-center justify-between p-2 bg-surface-light rounded-lg">
              <span class="text-sm text-text">Module ${score.module_number}: ${moduleNames[score.module_number - 1]}</span>
              <span class="text-sm font-bold ${score.score >= 80 ? 'text-success' : 'text-warning'}">${Math.round(score.score)}%</span>
            </div>
          `).join('');
        }

        loadingState.classList.add('hidden');
        validCert.classList.remove('hidden');
      } catch (err) {
        console.error('Verification error:', err);
        loadingState.classList.add('hidden');
        invalidCert.classList.remove('hidden');
      }
    }

    verifyCertificate();
  </script>
</BaseLayout>
